## ============================================================
## scenes/prologue.rpy
## P01_ROOM — «Билет»
## P02_BUS  — «Дорога»
## ============================================================

## ------------------------------------------------------------
## P01_ROOM — Билет
## Локация: комната Артёма (город)
## Время: ночь, около 23:00
## Музыка: mystery (fadein 2.0)
## Фон: bg room
## Персонажи: Артём (один)
## ------------------------------------------------------------

label p01_room:

    play music mystery fadein 2.0 if_changed
    call day_card("Пролог", "")

    scene bg room
    with fade

    "Одиннадцать вечера. Лампа гудит так, будто тоже не может уснуть." id p01_room_0001

    "Коробка приехала утром. Мама написала в сообщении три слова: «Разбери сам, пожалуйста»." id p01_room_0002

    "Двенадцать лет отец не появлялся в нашей жизни — и вот он целиком поместился в коробку из-под обуви." id p01_room_0003

    "Я разбирал её четыре часа. Нашёл: проездной на троллейбус, истёкший в две тысячи девятом; зажигалку без газа; три монеты, склеенные в стопку; инструкцию к радиостанции, от которой у меня заныли зубы." id p01_room_0004

    "Радиостанция. Инструкция к радиостанции." id p01_room_0005

    mc "Пап, ты серьёзно хранил инструкцию к рации?" id p01_room_0006

    "Мама говорит, он работал «где-то со связью». Мама вообще мало что говорит: она научилась произносить про него ровно три предложения и дальше переводила тему." id p01_room_0007

    mc "Ну здравствуй, пап. Что на этот раз: носки, документы или объяснение?" id p01_room_0008

    "Объяснения не было. Были: паспорт с истёкшим сроком, часы без ремешка, стопка квитанций, чужой свитер и старая куртка." id p01_room_0009

    "Куртка пахла пылью и чем-то неуловимо знакомым." id p01_room_0010

    "Хвоей. И ещё — рекой." id p01_room_0011

    "Я полез в карман и нащупал плотный бумажный прямоугольник." id p01_room_0012

    menu:
        "Осмотреть билет внимательно":
            $ has_ticket = True
            $ truth_points += 1

            if not frag_ticket:
                $ frag_ticket = True
                $ memory_fragments += 1

            "На выцветшей печати читалось: «Сосновый берег»." id p01_room_0013

            "Ниже от руки: «смена 20-я», «заезд 05.08», «отъезд 19.08»." id p01_room_0014

            "Отъезд был перечёркнут. Дважды." id p01_room_0015

            "Почерк на обороте казался до боли знакомым." id p01_room_0016

            "«20-я. Последняя.» И точка — поставленная с таким размахом, будто руку не остановили." id p01_room_0017

            mc "Значит, ты всё это хранил. Двенадцать лет молчал — и хранил билет." id p01_room_0018

            mc "Пап, а сказать вслух было нельзя?" id p01_room_0019

            "Я перевернул билет ещё раз. Бумага была мягкая от времени — такие билеты мнут в кармане годами, а не хранят в конверте." id p01_room_0020

            "Значит, он носил его с собой. Каждый день. Двадцать лет." id p01_room_0021

        "Просто убрать в карман":
            $ has_ticket = True

            if not frag_ticket:
                $ frag_ticket = True
                $ memory_fragments += 1

            "Я не стал вглядываться в буквы." id p01_room_0022

            "Но почему-то уже знал, что поеду." id p01_room_0023

            mc "Ладно. Один — ноль в твою пользу." id p01_room_0024

    "Автобус до Заречья уходил в шесть сорок. Дальше — четыре километра пешком, если верить карте." id p01_room_0025

    "Я не собирался ехать. Честно. Я лёг спать с твёрдым решением утром выбросить этот картон в мусор и забыть." id p01_room_0026

    "В шесть утра я уже стоял на автовокзале с рюкзаком." id p01_room_0027

    "Карта врала: на ней не было ни лагеря, ни дороги к нему." id p01_room_0028

    "Я всё равно положил билет в нагрудный карман." id p01_room_0029

    "Он был тёплый. Как будто его только что держали в руках." id p01_room_0030

    jump p02_bus


## ------------------------------------------------------------
## P02_BUS — Дорога
## Локация: автобус
## Время: утро
## Музыка: main_theme
## Фон: bg bus
## ------------------------------------------------------------

label p02_bus:

    play music main_theme fadein 1.0 if_changed
    scene bg bus
    with fade

    play sound bus_engine loop
    "Автобус тряхнуло на старой дороге." id p02_bus_0001

    "За окном тянулись сосны, выцветшие остановки и пустые перекрёстки." id p02_bus_0002

    "В салоне, кроме меня, ехали трое: водитель, женщина с рассадой и парень в наушниках." id p02_bus_0003

    "Никто не разговаривал." id p02_bus_0004

    "Женщина с рассадой держала на коленях ящик, из которого торчали помидорные кусты, и разговаривала с ними шёпотом." id p02_bus_0005

    "Парень в наушниках смотрел в телефон, но экран не светился. Я проверил дважды. Не светился." id p02_bus_0006

    "Остановку объявили через динамик — с такими помехами, будто запись делали в прошлом веке." id p02_bus_0007

    nvl show dissolve
    radio_nvl "…Заречье… далее по маршруту… не следует…" id p02_bus_0008
    nvl clear

    "Я спросил у женщины, здесь ли выходить к лагерю." id p02_bus_0009

    "Она кивнула и отвернулась к окну. Слишком быстро." id p02_bus_0010

    mc "А лагерь… он работает? В смысле, туда вообще можно?" id p02_bus_0011

    "Женщина помолчала. Потом сказала, не оборачиваясь:" id p02_bus_0012

    "«Туда все можно. Обратно — как получится»." id p02_bus_0013

    "Я решил, что ослышался. Или что это местная шутка для городских." id p02_bus_0014

    menu:
        "Смотреть в окно":
            "На стекле, с внутренней стороны, кто-то нарисовал солнце. Восемь лучей и кривая улыбка." id p02_bus_0015

            "Рисунок был свежий: палец оставлял след." id p02_bus_0016

            mc "Отлично. Значит, дети там всё-таки есть." id p02_bus_0017

            "Через сто метров солнце осталось позади — вместе с дорогой, которой не было на карте." id p02_bus_0018

        "Думать об отце":
            "Отец ушёл, когда мне было семь. Не умер и не пропал — ушёл." id p02_bus_0019

            "Это разные слова, и мама всегда следила, чтобы я их не путал." id p02_bus_0020

            "Последний раз мы говорили по телефону три года назад. Он спросил, как учёба. Я ответил." id p02_bus_0021

            "Он помолчал и сказал: «Если понадобишься — не найдёшь»." id p02_bus_0022

            mc "Ну спасибо. Очень поддерживающе." id p02_bus_0023

            "Я тогда решил, что это про работу. Сейчас, с билетом в кармане, я был не так уверен." id p02_bus_0024

    stop sound
    "Автобус остановился у ржавого навеса. Дальше — пешком." id p02_bus_0025

    "Четыре километра я прошёл за час." id p02_bus_0026

    jump d00_gate
