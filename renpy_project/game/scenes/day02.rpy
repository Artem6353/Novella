## ============================================================
## scenes/day02.rpy — ДЕНЬ 2, «ТРЕЩИНЫ»
## D2_MORNING      — «Утро в корпусе»
## D2_JOURNAL      — «Журнал смен»       (опциональная, +2 правды)
## D2_RADIO_REPAIR — «Ремонт радио»      (открывает/закрывает ветку Веры)
## D2_LENA_WARNING — «Предупреждение Лены» (открывает/закрывает ветку Лены)
## D2_NIGHT_CHECK  — «Ночь» (техническая проверка truth_points)
## D2_NIGHT_FOREST — «Лес»  (единственный источник father_clue)
## ============================================================

## ------------------------------------------------------------
## D2_MORNING — Утро в корпусе
## Локация: жилой корпус, комната 12
## Время: утро
## Музыка: mystery
## Фон: bg dorm_day
## ------------------------------------------------------------

label d2_morning:

    call day_card("День 2", "Трещины")

    play music mystery fadein 1.0 if_changed
    scene bg dorm_day
    with fade

    "Утро в корпусе было странным." id d2_morning_0001

    "На секунду мне показалось, что за окном снова тот же самый день." id d2_morning_0002

    "Свет падал под тем же углом. Стакан стоял на том же месте. Расписание было обведено дважды — поверх одной и той же даты." id d2_morning_0003

    "Вчера я вылил из стакана воду. Сегодня она снова была полной." id d2_morning_0004

    mc "Ладно. Усталость. Пыльца. Массовая галлюцинация на двести человек." id d2_morning_0005

    "Я сел на кровать и поймал себя на том, что считаю." id d2_morning_0006

    "Скрип качелей за окном. Раз. Два. Три. Пауза. Раз. Два. Три." id d2_morning_0007

    "Как метроном, у которого закончилась заводка, но не закончилась работа." id d2_morning_0008

    "Что-то подсказывало мне, что в комнате есть то, что я ещё не видел." id d2_morning_0009

    "Я обошёл комнату. Шесть шагов в одну сторону, шесть в другую. Кровать, тумбочка, стул, окно, гвоздь в стене вместо вешалки." id d2_morning_0010

    "Всё как вчера. И всё — не так." id d2_morning_0011

    "На гвозде висела моя куртка. Я вешал её на спинку стула." id d2_morning_0012

    mc "Хорошо. Значит, здесь кто-то наводит порядок. Очень заботливый кто-то." id d2_morning_0013

    "Я достал телефон. Экран показал 08:00, восемнадцатое августа, и ноль процентов заряда." id d2_morning_0014

    "Вчера было ноль процентов заряда." id d2_morning_0015

    "И вчера было восемнадцатое августа." id d2_morning_0016

    "Я сунул телефон в карман и посмотрел на тумбочку так, будто она была виновата." id d2_morning_0017

    menu:
        "Обыскать комнату":
            if drawing_found and not zoya_sketch_found:
                $ zoya_sketch_found = True
                $ zoya_love += 2

                "В тумбочке, под старым журналом, я нашёл сложенный вчетверо лист." id d2_morning_0018

                "Набросок: река, причал и фигура у воды. Фигура держала в поднятой руке фонарь." id d2_morning_0019

                "Внизу виднелась подпись: «З.»" id d2_morning_0020

                "Я узнал эту руку. Вчера она раскладывала передо мной целый вечер." id d2_morning_0021

                mc "Зоя, значит, ты и здесь успела." id d2_morning_0022

                "Я аккуратно положил лист обратно. Почему-то было важно, чтобы он лежал так же." id d2_morning_0023

            else:
                "В тумбочке не было ничего, кроме пыли, чьей-то пуговицы и засохшего цветка." id d2_morning_0024

                "Цветок был придавлен так, будто его положили сюда специально — и очень давно." id d2_morning_0025

            "Под самой тумбочкой, в стопке макулатуры, которую сюда свалили, видимо, ещё при прошлом директоре, что-то блеснуло корешком." id d2_morning_0026
            if not journal_found:
                jump d2_journal
            else:
                jump d2_radio_repair

        "Выйти и пойти к радиоузлу":
            "Я решил, что комната никуда не денется." id d2_morning_0027

            "Она и не делась. Просто потом мне было труднее вспомнить, зачем я сюда вернулся." id d2_morning_0028

            jump d2_radio_repair


## ------------------------------------------------------------
## D2_JOURNAL — Журнал смен
## Локация: библиотека / тумбочка в корпусе
## Время: утро
## Музыка: main_theme
## Фон: bg library
## Эффект: journal_found, truth_points += 2, frag_journal
## ------------------------------------------------------------

label d2_journal:

    play music main_theme fadein 1.0 if_changed
    scene bg library
    with fade

    play sound door
    "Это был журнал смен." id d2_journal_0001

    "Толстый, в дерматиновой обложке, с надписью от руки: «Лагерь „Сосновый берег“. Смена 20-я»." id d2_journal_0002

    "Страницы слиплись. Их намочили и высушили — давно и без старания." id d2_journal_0003

    "Первая страница: список сотрудников." id d2_journal_0004

    "«Гарина Е. — старшая вожатая»." id d2_journal_0005

    "«Воронов И. — радиоузел, связь»." id d2_journal_0006

    "«Лагутина В. — выпускница, эфир»." id d2_journal_0007

    "«Мельник З. — выпускница, оформление»." id d2_journal_0008

    mc "Стоп." id d2_journal_0009

    "Я перечитал четыре фамилии трижды." id d2_journal_0010

    "Вера. Зоя. Лена. И мой отец." id d2_journal_0011

    "Дальше шли отметки: «подъём», «завтрак», «полдник», «тихий час», «костёр». Одинаковые, ровные, как дыхание спящего." id d2_journal_0012

    "Последняя заполненная дата — восемнадцатое августа." id d2_journal_0013

    "После неё — разлинованная пустота на тридцать страниц." id d2_journal_0014

    "И только на самой последней, почти неразборчиво, карандашом:" id d2_journal_0015

    "«Лена не вышла к…»" id d2_journal_0016

    "Строку кто-то оборвал: бумага была надорвана и склеена скотчем." id d2_journal_0017

    mc "Куда — не вышла, Лена?" id d2_journal_0018

    "Я перевернул журнал. На задней обложке, мелким почерком, тем же, что и на билете:" id d2_journal_0019

    "«Если не успею — не ищи»." id d2_journal_0020

    $ journal_found = True
    $ truth_points += 2

    if not frag_journal:
        $ frag_journal = True
        $ memory_fragments += 1

    mc "Двадцать лет назад все четверо были здесь. Трое до сих пор здесь." id d2_journal_0021

    mc "И я очень надеюсь, что четвёртый — нет." id d2_journal_0022

    "Я положил журнал под куртку. Он был тяжёлым не по размеру." id d2_journal_0023

    "Я пролистал середину ещё раз — медленно, ища хоть что-нибудь, за что можно зацепиться." id d2_journal_0024

    "Нашёл." id d2_journal_0025

    "На странице от десятого августа, между «полдник» и «тихий час», кто-то вписал одну строку другим почерком:" id d2_journal_0026

    "«Причал осмотреть до отъезда. Отложить нельзя»." id d2_journal_0027

    "Рядом стояла галочка. Одна. И больше ничего." id d2_journal_0028

    mc "Кто отложил, пап? И кто поставил галочку?" id d2_journal_0029

    "Ответов в журнале не было. В журналах вообще редко бывают ответы — там только отметки о том, что вопрос задавали." id d2_journal_0030

    "На полях карандашом, детским почерком: «Миша (9) — дежурный по лодке. Костя (8) — крутит приёмник. Аня (7) — рисует рассвет, чтобы он пришёл»." id d2_journal_0100

    "Я закрыл журнал и услышал, как за стеной кто-то включил радио." id d2_journal_0031

    play sound radio_noise
    "Оно играло ровно четыре секунды и замолчало." id d2_journal_0032

    jump d2_radio_repair


## ------------------------------------------------------------
## D2_RADIO_REPAIR — Ремонт радио
## Локация: радиоузел
## Время: день
## Музыка: vera_theme
## Фон: bg radio
## Эффект: radio_fixed / vera_love, frag_cassette
## ВАЖНО: отказ закрывает маршрут Веры (нужен radio_fixed == True)
## ------------------------------------------------------------

label d2_radio_repair:

    play music vera_theme fadein 1.0 if_changed
    scene bg radio
    with fade

    "Вера снова возилась с проводами." id d2_radio_repair_0001

    "Радиоузел гудел, но эфир не выходил." id d2_radio_repair_0002

    show vera stubborn at tr_right
    with dissolve

    vera "Не работает. То есть работает, но не туда. Понимаешь разницу?" id d2_radio_repair_0003

    mc "Смутно." id d2_radio_repair_0004

    vera "Отлично, значит, ты готов мне помочь. Держи отвёртку." id d2_radio_repair_0005

    "На столе лежала схема, нарисованная от руки, и три кассеты без подписей." id d2_radio_repair_0006

    vera "Антенна цела, кабель целый, а сигнал уходит внутрь и там остаётся. Как будто ему тут нравится." id d2_radio_repair_0007

    mc "Вера, а зачем тебе эфир, если тебя никто не слушает?" id d2_radio_repair_0008

    show vera thoughtful
    with dissolve

    vera "Как это — никто?" id d2_radio_repair_0009

    "Она сказала это так искренне, что я не стал спорить." id d2_radio_repair_0010

    menu:
        "Помочь починить радио":
            $ radio_fixed = True
            $ vera_love += 2

            if not frag_cassette:
                $ frag_cassette = True
                $ memory_fragments += 1

            "Полтора часа, два ожога от паяльника и одна очень плохая шутка Веры про «радиолюбителя с руками из плеч»." id d2_radio_repair_0011

            "Стрелка на панели дрогнула и встала." id d2_radio_repair_0012

            show vera excited
            with dissolve

            vera "Есть! Есть контакт! Ты гений, я гений, мы оба гении, но я больше!" id d2_radio_repair_0013

            play sound cassette
            "Кассета щёлкнула, и из динамика вырвался голос." id d2_radio_repair_0014

            play sound radio_noise
            radio "…говорит радиоузел „Соснового берега“…" id d2_radio_repair_0015

            radio "…всем отрядам построиться у…" id d2_radio_repair_0016

            "И помехи." id d2_radio_repair_0017

            "Потом, сквозь помехи, прорвалось ещё одно слово. Мужской голос, молодой, сорванный:" id d2_radio_repair_0018

            young_voice "…кто-нибудь, ответьте…" id d2_radio_repair_0019

            "Я знал этот голос." id d2_radio_repair_0020

            "Так он звучал на единственной домашней записи, которую мама не выбросила." id d2_radio_repair_0021

            mc "Это кто?" id d2_radio_repair_0022

            show vera determined
            with dissolve

            vera "Не знаю. Плёнка старая, я её нашла в шкафу." id d2_radio_repair_0023

            "Плёнка шуршала. И сквозь шуршание, почти на границе слышимости, добавилось то, чего раньше не было: шёпот." id d2_radio_repair_0100

            young_voice "Лена, прости. Я скажу завтра." id d2_radio_repair_0101

            "Завтра не наступило никогда. Я стоял с кассетой в руках и впервые не знал, чьё сердце бьётся громче — моё или плёнки." id d2_radio_repair_0102

            "Она потянулась выключить — и не выключила." id d2_radio_repair_0024

            "Вера впервые за весь день замолчала." id d2_radio_repair_0025

            "Я считал секунды. На седьмой она не выдержала." id d2_radio_repair_0026

            vera "Так. Ладно. Завтра — эфир. Настоящий. До конца. Без вот этого." id d2_radio_repair_0027

            mc "Без чего?" id d2_radio_repair_0028

            vera "Без пауз." id d2_radio_repair_0029

        "Отказаться или отложить ремонт":
            $ vera_love -= 1

            mc "У меня завтра автобус. Мне бы связь найти, а не антенну паять." id d2_radio_repair_0030

            show vera offended
            with dissolve

            vera "А, ну да. Логично. Очень логично." id d2_radio_repair_0031

            "Она отвернулась к пульту и заговорила с проводами — вслух, вежливо, как с посторонними." id d2_radio_repair_0032

            "Радио не починилось. Эфир в этот день не вышел." id d2_radio_repair_0033

            mc "Я помогу завтра." id d2_radio_repair_0034

            vera "Конечно поможешь. Все помогают завтра." id d2_radio_repair_0035

            "Она улыбнулась. Улыбка была на месте, а глаза — нет." id d2_radio_repair_0036

    hide vera
    with dissolve

    jump d2_lena_warning


## ------------------------------------------------------------
## D2_LENA_WARNING — Предупреждение Лены
## Локация: река
## Время: закат
## Музыка: lena_theme
## Фон: bg river
## Эффект: trusted_lena / lena_love, truth_points += 1
## ВАЖНО: «Усомниться» закрывает маршрут Лены (нужен trusted_lena)
## ------------------------------------------------------------

label d2_lena_warning:

    play music lena_theme fadein 1.0 if_changed
    scene bg river
    with fade

    play sound river loop
    "Я увидел её раньше, чем услышал: белая рубашка на фоне тёмной воды." id d2_lena_warning_0001

    "Она стояла лицом к тропинке, а не к реке. Так стоят, когда ждут конкретного человека." id d2_lena_warning_0002

    show lena anxious at tr_right
    with dissolve

    lena "Ты чувствуешь, что это место неправильное?" id d2_lena_warning_0003

    mc "Я чувствую, что у меня второй день не заряжается телефон." id d2_lena_warning_0004

    lena "Артём." id d2_lena_warning_0005

    mc "Да?" id d2_lena_warning_0006

    lena "Завтра будет тот же день." id d2_lena_warning_0007

    "Я ждал продолжения. Продолжения не было." id d2_lena_warning_0008

    mc "В смысле — погода?" id d2_lena_warning_0009

    show lena sad
    with dissolve

    lena "В смысле — всё. Подъём в восемь. Плакат в столовой. Мальчик, который крикнет про линейку в семь. Я скажу тебе «не стоит», ты спросишь «почему»." id d2_lena_warning_0010

    lena "И послезавтра тоже. Я считала." id d2_lena_warning_0011

    mc "Сколько?" id d2_lena_warning_0012

    "Она не ответила сразу." id d2_lena_warning_0013

    lena "Достаточно, чтобы перестать считать вслух." id d2_lena_warning_0014

    menu:
        "Поверить Лене":
            $ trusted_lena = True
            $ lena_love += 2
            $ truth_points += 1

            mc "Хорошо. Допустим, я тебе верю. Что мне делать?" id d2_lena_warning_0015

            show lena smile
            with dissolve

            lena "Смотреть. Слушать. И не уезжать девятнадцатого." id d2_lena_warning_0016

            mc "А что будет девятнадцатого?" id d2_lena_warning_0017

            lena "Ничего." id d2_lena_warning_0018

            lena "В этом и проблема." id d2_lena_warning_0019

            mc "Лена, я вчера нашёл билет двадцатилетней давности. Сегодня — журнал смен, где моя фамилия стоит рядом с твоей." id d2_lena_warning_0020

            show lena surprised
            with dissolve

            lena "Ты нашёл журнал?" id d2_lena_warning_0021

            mc "Нашёл." id d2_lena_warning_0022

            lena "Значит, лагерь решил, что ты готов." id d2_lena_warning_0023

            mc "Готов к чему?" id d2_lena_warning_0024

            show lena sad
            with dissolve

            lena "Не ходи сегодня к реке после заката. И если услышишь колокол — иди на него. Но не один." id d2_lena_warning_0025

            mc "Это два противоречащих совета." id d2_lena_warning_0026

            lena "Да. Выбери тот, который будет важнее." id d2_lena_warning_0027

        lena "И ещё. Я хочу, чтобы меня отпустили. Не забыли — отпустили. Это разные слова, и я двадцать лет учила разницу между ними." id d2_lena_warning_0100

        "Усомниться":
            $ lena_love -= 1

            mc "Лена, это называется усталость. Я не спал, приехал, наглотался пыли." id d2_lena_warning_0028

            mc "И ещё: я вчера нашёл в тумбочке журнал двадцатилетней давности. Это не мистика, это свалка." id d2_lena_warning_0029

            show lena sad
            with dissolve

            lena "Конечно." id d2_lena_warning_0030

            "Она кивнула. Слишком быстро." id d2_lena_warning_0031

            lena "Ты прав. Я просто… не хочу быть единственной, кто это помнит." id d2_lena_warning_0032

            mc "Кто это — помнит?" id d2_lena_warning_0033

            "Но она уже смотрела на воду, и разговор закончился." id d2_lena_warning_0034

            "Она не стала спорить. И это было хуже спора." id d2_lena_warning_0035

    hide lena
    with dissolve

    jump d2_night_check


## ------------------------------------------------------------
## D2_NIGHT_CHECK — Ночь (техническая сцена)
## Локация: площадь / окно корпуса
## Время: ночь
## Музыка: mystery
## Фон: bg square_night
## Эффект: переменные не меняет; проверяет truth_points >= 3
## ------------------------------------------------------------

label d2_night_check:

    play music mystery fadein 1.0 if_changed
    scene bg square_night
    with fade

    play sound crickets loop
    "Небо над лагерем потемнело." id d2_night_check_0001

    "Площадь была пуста: ни детей, ни вожатых, ни дежурного света у корпуса." id d2_night_check_0002

    "Только где-то далеко, на другой стороне, пробежал мальчик." id d2_night_check_0003

    child "Линейка в семь! Не опаздывай!" id d2_night_check_0004

    "Те же слова. Та же интонация. Тот же самый мальчик." id d2_night_check_0005

    "Я посмотрел на часы. Было начало одиннадцатого." id d2_night_check_0006

    mc "Восемнадцатое августа. Опять." id d2_night_check_0007

    "Я посмотрел на небо. Звёзды были на тех же местах, что и вчера. Не похоже — а именно на тех же." id d2_night_check_0008

    "Где-то за корпусом скрипнули качели. Раз, два, три. Пауза." id d2_night_check_0009

    "Я поймал себя на том, что жду четвёртого скрипа. Его не было." id d2_night_check_0010
    if truth_points >= 3:
        "Сегодня я узнал достаточно. Или почти достаточно." id d2_night_check_0011

        "Из-за деревьев донёсся звук, которого в лагере быть не могло." id d2_night_check_0012

        play sound bell
        "Колокол. Один удар. Потом ещё один — тише, будто кто-то пробовал его на звук." id d2_night_check_0013

        "Я не хотел идти." id d2_night_check_0014

        "Я пошёл." id d2_night_check_0015

        jump d2_night_forest
    else:
        "Сегодня я не узнал почти ничего." id d2_night_check_0016

        "Ни звука, ни знака, ни повода остаться." id d2_night_check_0017

        "Я лёг спать и сказал себе, что завтра уеду первым же автобусом." id d2_night_check_0018

        "Мне даже удалось в это поверить. На четыре минуты." id d2_night_check_0019

        jump d3_route_select


## ------------------------------------------------------------
## D2_NIGHT_FOREST — Лес
## Локация: лес за корпусами, спуск к воде
## Время: ночь
## Музыка: mystery
## Фон: bg forest_night
## Эффект: father_clue, frag_photo (только при «Идти на звук»)
## ВАЖНО: единственный источник father_clue — без него секретная
## концовка в этом прохождении недостижима. «Уйти» НЕ ставит escape_flag.
## ------------------------------------------------------------

label d2_night_forest:

    play music mystery fadein 1.0 if_changed
    scene bg forest_night
    with fade

    play sound wind loop
    "В лесу было темно и тихо." id d2_night_forest_0001

    "Слишком тихо: ни комаров, ни листвы, ни ночных птиц." id d2_night_forest_0002

    "Где-то в глубине звенел старый колокол." id d2_night_forest_0003

    play sound bell
    "Тропинка шла под уклон, к воде. Воздух стал тяжёлым и пах мокрой корой." id d2_night_forest_0004

    play sound owl
    "Я остановился." id d2_night_forest_0005

    "Впереди, у самого спуска, стоял свет. Не фонарь на столбе — фонарь в руке." id d2_night_forest_0006

    "Свет качнулся три раза. Влево, вправо, вниз." id d2_night_forest_0007

    "Как сигнал." id d2_night_forest_0008

    mc "Эй! Тут кто-нибудь есть?" id d2_night_forest_0009

    "Никто не ответил. Свет погас." id d2_night_forest_0010

    menu:
        "Идти на звук":
            $ father_clue = True

            if not frag_photo:
                $ frag_photo = True
                $ memory_fragments += 1

            "Я спустился к воде, спотыкаясь о корни." id d2_night_forest_0011

            "Там, где тропинка упиралась в старый причал, под корягой, придавленная камнем, лежала фотография." id d2_night_forest_0012

            "Двадцать человек в два ряда. Внизу от руки: «20-я смена. 18.08»." id d2_night_forest_0013

            "Слева стояла Лена. Такая же, как сейчас. Ни на год старше." id d2_night_forest_0014

            "Рядом с ней — молодой парень в рубашке с чужого плеча." id d2_night_forest_0015

            "Я узнал его по часам. Ремешка не было и тогда." id d2_night_forest_0016

            mc "Пап. Какого чёрта." id d2_night_forest_0017

            "На обороте, тем же почерком, что и на билете:" id d2_night_forest_0018

            "«Лена и И. Пусть это лето не кончается»." id d2_night_forest_0019

            "Я стоял очень долго." id d2_night_forest_0020

            "Потом колокол ударил ещё раз — и замолчал совсем." id d2_night_forest_0021

            "Я сунул фотографию за пазуху, рядом с билетом." id d2_night_forest_0022

            "Два куска бумаги, которые двадцать лет ждали, пока их кто-нибудь прочитает." id d2_night_forest_0023

        "Уйти":
            "Я развернулся и пошёл обратно." id d2_night_forest_0024

            "За спиной кто-то тихо сказал: «Правильно»." id d2_night_forest_0025

            "Я не стал проверять, кто." id d2_night_forest_0026

            "Что-то осталось скрытым в темноте. И, кажется, темнота была этому рада." id d2_night_forest_0027

            mc "Нет. Ночью по лесу я не хожу. Это не трусость, это статистика." id d2_night_forest_0028

    play sound gravel
    "Я стоял у кромки воды и смотрел на причал." id d2_night_forest_0029

    "Доски были мокрые, хотя дождя не было." id d2_night_forest_0030

    "Самая крайняя секция провисла, и под ней темнела вода — чёрная, без отражений." id d2_night_forest_0031

    mc "Значит, вот ты какой." id d2_night_forest_0032

    "Я не стал подходить ближе. Лента на тропинке висела не просто так." id d2_night_forest_0033
    if father_clue:
        "На обратной стороне фотографии, которую я поднял под корягой, был приклеен ещё один кусочек бумаги — маленький, в два ногтя." id d2_night_forest_0034

        "Я поднёс его к свету." id d2_night_forest_0035

        "Это был обрывок расписания: «19:00 — линейка». И ниже, карандашом: «не опаздывай»." id d2_night_forest_0036

        mc "Значит, ты знал, что не успеешь." id d2_night_forest_0037

    else:
        "Под ногами что-то хрустнуло. Я не стал смотреть что." id d2_night_forest_0038

        "Всю обратную дорогу я думал о том, что оставил под корягой — там, куда не дошёл." id d2_night_forest_0039

        "Думать об этом было удобнее, чем возвращаться." id d2_night_forest_0040

    "Обратно я шёл быстрее, чем сюда." id d2_night_forest_0041

    "И всю дорогу мне казалось, что кто-то идёт в такт, на два шага позади." id d2_night_forest_0042

    "На границе лагеря я остановился: за спиной было темно так, что темноту можно было потрогать." id d2_night_forest_0100

    lena_e "Ты всё ещё думаешь, что это место наказывает." id d2_night_forest_0101

    "Голос Лены пришёл из темноты между сосен. Спокойный, без эха — так говорят рядом, а не далеко." id d2_night_forest_0102

    lena_e "Это не наказание, Артём. Это петля. И у неё три правила." id d2_night_forest_0103

    lena_e "Первое: сигнал не принят — смена повторяется. Пока просьба о помощи не дослушана до конца, день начинается заново." id d2_night_forest_0104

    lena_e "Второе: разорвать петлю может только внешний. Тот, кого здесь не было двадцать лет. Тот, кто приехал с билетом, а не с памятью." id d2_night_forest_0105

    lena_e "Третье: конец наступает, когда прощание завершено. Не когда забыто — когда сказано вслух и дослушано." id d2_night_forest_0106

    "Я обернулся. На тропинке не было никого. Только колокол где-то далеко ударил четвёртый раз — и растворился." id d2_night_forest_0107

    mc "Три правила. Я запомнил. Потому что ты не будешь повторять." id d2_night_forest_0108

    jump d3_route_select
