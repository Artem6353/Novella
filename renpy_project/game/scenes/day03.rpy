## ============================================================
## scenes/day03.rpy — ДЕНЬ 3, «РАЗДЕЛЕНИЕ»
## D3_ROUTE_SELECT — выбор маршрута (escape_flag сбрасывается!)
## D3_LENA_BRANCH  — «Заброшенный корпус»
## D3_VERA_BRANCH  — «Последний эфир»
## D3_ZOYA_BRANCH  — «Рисунок-предсказание»
## D3_ALONE        — «Одиночество» (route="none", escape_flag=True)
## D3_GLITCH       — «Сбой лагеря» (техническая, без выбора)
## ============================================================

## ------------------------------------------------------------
## D3_ROUTE_SELECT — Выбор маршрута
## Локация: главная площадь
## Время: утро
## Музыка: main_theme
## Фон: bg square
## ------------------------------------------------------------

label d3_route_select:

    call day_card("День 3", "Разделение")

    play music main_theme fadein 1.0 if_changed
    scene bg square
    with fade

    ## Защитный сброс: escape_flag может быть установлен ТОЛЬКО в d3_alone.
    $ escape_flag = False

    "Площадь опустела." id d3_route_select_0001

    "Я должен был решить, с кем провести этот день." id d3_route_select_0002

    "Лена стояла у четвёртого корпуса — того самого, куда никто не заходил. Она не звала, просто ждала, положив руку на облупленную краску." id d3_route_select_0003

    "Из радиоузла слышалось, как Вера ругается с антенной. Громко, изобретательно и, кажется, на «ты»." id d3_route_select_0004

    "В окне библиотеки Зоя раскладывала листы в три аккуратные стопки." id d3_route_select_0005

    "Или я мог не выбирать никого. И пойти своей дорогой." id d3_route_select_0006

    "Я подумал о том, что за два дня узнал о трёх людях больше, чем о своём отце за девятнадцать лет." id d3_route_select_0007

    "Что Вера ненавидит паузы, потому что в паузах слышно повтор." id d3_route_select_0008

    "Что Зоя делит мир на три стопки, потому что иначе он не держится." id d3_route_select_0009

    "Что Лена помнит всё до последней ночи и ничего после — и что это, наверное, самое страшное, что я слышал в этом лагере." id d3_route_select_0010

    "И что все трое ждут от меня чего-то, чего я пока не понимаю." id d3_route_select_0011

    mc "Ладно. Один день. Посмотрим, что вы мне покажете." id d3_route_select_0012

    menu:
        "Пойти с Леной" if lena_love >= 3 and trusted_lena:
            $ route = "lena"
            jump d3_lena_branch

        "Помочь Вере" if vera_love >= 3 and radio_fixed:
            $ route = "vera"
            jump d3_vera_branch

        "Пойти с Зоей" if zoya_love >= 3 and drawing_found:
            $ route = "zoya"
            jump d3_zoya_branch

        "Остаться одному":
            jump d3_alone


## ------------------------------------------------------------
## D3_LENA_BRANCH — Заброшенный корпус
## Локация: четвёртый корпус, вожатская
## Время: день
## Музыка: lena_theme
## Фон: bg abandoned
## Эффект: lena_love += 2, truth_points += 2
## ------------------------------------------------------------

label d3_lena_branch:

    play music lena_theme fadein 1.0 if_changed
    scene bg abandoned
    with fade

    play sound door
    "Лена привела меня в заброшенный корпус." id d3_lena_branch_0001

    "Здесь пахло пылью и старыми бумагами." id d3_lena_branch_0002

    "Вожатская. Четыре стула, стол, гитара без одной струны и стенгазета на всю стену: «До свидания, лето!»" id d3_lena_branch_0003

    "Под заголовком кто-то нарисовал костёр, палатку и лодку. Лодка была закрашена аккуратнее всех." id d3_lena_branch_0004

    show lena normal at tr_right
    with dissolve

    lena "Я хочу, чтобы ты увидел это сам." id d3_lena_branch_0005

    mc "Что именно?" id d3_lena_branch_0006

    lena "Что мы были." id d3_lena_branch_0007

    "Она провела рукой по столу. Пыль не поднялась." id d3_lena_branch_0008

    "На столе лежали списки отрядов. В первом — двадцать восемь имён, во втором — тридцать одно." id d3_lena_branch_0009

    "Внизу каждого списка — подпись: «ст. вожатая Гарина»." id d3_lena_branch_0010

    mc "Гарина. Это ты." id d3_lena_branch_0011

    lena "Это фамилия." id d3_lena_branch_0012

    mc "Ты её произнесла как чужую." id d3_lena_branch_0013

    show lena sad
    with dissolve

    lena "Я помню всё до последней ночи. План линейки, кто с кем поссорился, что Вера спрятала микрофон, чтобы её искали." id d3_lena_branch_0014

    lena "И ничего после." id d3_lena_branch_0015

    lena "Я не помню отъезда. Знаешь, как это — не помнить конца?" id d3_lena_branch_0016

    mc "Нет." id d3_lena_branch_0017

    lena "Это как книга, из которой вырвали последнюю страницу. И все делают вид, что так и было задумано." id d3_lena_branch_0018

    "Я положил на стол фотографию из леса — если нашёл её." id d3_lena_branch_0019
    if father_clue:
        lena "Где ты это взял?" id d3_lena_branch_0020

        mc "Под корягой. У причала." id d3_lena_branch_0021

        "Она смотрела на снимок очень долго и не взяла его в руки." id d3_lena_branch_0022

        show lena anxious
        with dissolve

        lena "Он был здесь. В ту ночь." id d3_lena_branch_0023

        mc "Кто?" id d3_lena_branch_0024

        lena "Тот, кто должен был говорить в эфир." id d3_lena_branch_0025

    else:
        lena "Ты ничего не нашёл." id d3_lena_branch_0026

        mc "Ночью по лесу не гуляю." id d3_lena_branch_0027

        show lena smile
        with dissolve

        lena "Правильно. Ночью тут действительно нечего делать." id d3_lena_branch_0028

        "Она сказала это слишком спокойно." id d3_lena_branch_0029

    mc "Лена. Что случилось восемнадцатого августа?" id d3_lena_branch_0030

    show lena anxious
    with dissolve

    lena "Была гроза. Река поднялась. Младшие пошли смотреть на воду — им всегда кажется, что вода интереснее взрослых." id d3_lena_branch_0031

    lena "Причал был старый. Все знали. Все говорили: «осенью починим»." id d3_lena_branch_0032

    mc "А дальше?" id d3_lena_branch_0033

    lena "А дальше я должна была увести их к лодкам." id d3_lena_branch_0034

    "Пауза." id d3_lena_branch_0035

    lena "Я увела." id d3_lena_branch_0036

    mc "Всех?" id d3_lena_branch_0037

    show lena sad
    with dissolve

    lena "Всех, кого нужно было." id d3_lena_branch_0038

    mc "Это не ответ." id d3_lena_branch_0039

    lena "Это всё, что я могу сказать до того, как ты увидишь сам." id d3_lena_branch_0040

    "Я отвернулся к окну. За стеклом была площадь, флагшток и та же тропинка к причалу." id d3_lena_branch_0041

    "И в стекле был только я." id d3_lena_branch_0042

    mc "Лена." id d3_lena_branch_0043

    lena "Да?" id d3_lena_branch_0044

    mc "Подойди сюда." id d3_lena_branch_0045

    "Она подошла. В стекле по-прежнему был только я — и пустое место рядом, где стоял кто-то, кого стекло не признавало." id d3_lena_branch_0046

    show lena mystery
    with dissolve

    lena "Не надо смотреть." id d3_lena_branch_0047

    mc "Смотря что понимать под словом „смотреть“." id d3_lena_branch_0048

    "Она улыбнулась. И повторила фразу, которую сказала мне у ворот — слово в слово:" id d3_lena_branch_0049

    lena_e "Смотря что ты понимаешь под словом «живой»." id d3_lena_branch_0050

    "Голос прозвучал дважды. Второй раз — из дальнего угла вожатской, где никого не было." id d3_lena_branch_0051

    $ lena_love += 2
    $ truth_points += 2

    hide lena
    with dissolve

    jump d3_glitch


## ------------------------------------------------------------
## D3_VERA_BRANCH — Последний эфир
## Локация: радиоузел
## Время: день
## Музыка: vera_theme
## Фон: bg radio
## Эффект: vera_love += 2
## ------------------------------------------------------------

label d3_vera_branch:

    play music vera_theme fadein 1.0 if_changed
    scene bg radio
    with fade

    play sound cassette
    "Вера включила радиоузел." id d3_vera_branch_0001

    "Вернее, включила его целиком: оба микрофона, все шесть кассет, лампу на пульте и даже тот самый шатающийся стул — он, кажется, тоже работал от сети." id d3_vera_branch_0002

    show vera determined at tr_right
    with dissolve

    vera "Сегодня мы закончим эфир." id d3_vera_branch_0003

    mc "Какой эфир? У тебя выпуск на завтра." id d3_vera_branch_0004

    vera "Не тот. Другой. Тот, который оборвался." id d3_vera_branch_0005

    "Она высыпала на стол кассеты. У трёх были подписи, у трёх — нет." id d3_vera_branch_0006

    vera "Вот эта — моя. Вот эта — тоже моя. А вот эта… послушай." id d3_vera_branch_0007

    play sound radio_noise
    radio "…всем отрядам построиться у…" id d3_vera_branch_0008

    "Помехи." id d3_vera_branch_0009

    mc "Ты это уже включала вчера." id d3_vera_branch_0010

    show vera thoughtful
    with dissolve

    vera "Вчера я включала плёнку. Сегодня — микрофон." id d3_vera_branch_0011

    "Она перемотала. Нажала «запись». Нажала «стоп»." id d3_vera_branch_0012

    vera "Слушай." id d3_vera_branch_0013

    play sound broadcast loop
    "Из динамика пошёл её собственный голос." id d3_vera_branch_0014

    vera "…и передаём привет четвёртому отряду, который опять украл микрофон…" id d3_vera_branch_0015

    show vera stubborn
    with dissolve

    vera "Стоп. Я этого не говорила." id d3_vera_branch_0016

    mc "Когда?" id d3_vera_branch_0017

    vera "Никогда. Это я скажу через минуту. Я уже придумала эту фразу, но ещё не сказала." id d3_vera_branch_0018

    "Пауза. Две секунды. Для Веры — почти катастрофа." id d3_vera_branch_0019

    vera "Ладно. Ладно! Значит, я хотя бы не пропала из эфира." id d3_vera_branch_0020

    mc "Вера." id d3_vera_branch_0021

    show vera offended
    with dissolve

    vera "Не надо меня жалеть, я этого не выношу, у меня от жалости сразу голос садится, а мне ещё двенадцать минут говорить." id d3_vera_branch_0022

    mc "Я не собирался." id d3_vera_branch_0023

    vera "Отлично. Тогда держи лист, будешь хронометражистом." id d3_vera_branch_0024

    show vera excited
    with dissolve

    "Следующие два часа мы монтировали выпуск из обрывков: её голос, чужой голос, помехи, песня про костёр и четыре секунды тишины, которые Вера вырезала лично." id d3_vera_branch_0025

    vera "Тишину не оставляем. Никогда." id d3_vera_branch_0026

    mc "Почему?" id d3_vera_branch_0027

    show vera thoughtful
    with dissolve

    vera "Потому что в тишине слышно, как лагерь повторяется." id d3_vera_branch_0028

    mc "И как?" id d3_vera_branch_0029

    vera "Как заезженная пластинка. Только заезженная — это мы." id d3_vera_branch_0030

    mc "Вера, ты сейчас сама себя перебила." id d3_vera_branch_0031

    vera "Я себя процитировала. В моём эфире даже цитаты под цензурой." id d3_vera_branch_0032

    show vera happy
    with dissolve

    "Она засмеялась — и на этот раз смех был нужной длины." id d3_vera_branch_0033

    "В самом конце мы записали объявление:" id d3_vera_branch_0034

    vera "Говорит радиоузел лагеря «Сосновый берег». Смена двадцатая. Закрытие — завтра в девятнадцать ноль-ноль." id d3_vera_branch_0035

    "Она нажала «стоп» и посмотрела на меня." id d3_vera_branch_0036

    show vera determined
    with dissolve

    vera "Завтра это должно выйти в эфир. Настоящим голосом. Придёшь?" id d3_vera_branch_0037

    mc "Приду." id d3_vera_branch_0038

    vera "Хорошо. Потому что одному нельзя. Если в эфире один голос — это монолог. А нам нужен именно эфир." id d3_vera_branch_0039

    $ vera_love += 2

    hide vera
    with dissolve

    jump d3_glitch


## ------------------------------------------------------------
## D3_ZOYA_BRANCH — Рисунок-предсказание
## Локация: библиотека / мастерская
## Время: день
## Музыка: zoya_theme
## Фон: bg library
## Эффект: zoya_love += 2, drawing_completed = True
## ------------------------------------------------------------

label d3_zoya_branch:

    play music zoya_theme fadein 1.0 if_changed
    scene bg library
    with fade

    "Зоя разложила рисунки на столе." id d3_zoya_branch_0001

    "Три стопки. Ровные, как будто их мерили линейкой." id d3_zoya_branch_0002

    show zoya calm at tr_right
    with dissolve

    zoya "Слева — было. Посередине — есть. Справа — будет." id d3_zoya_branch_0003

    mc "Ты серьёзно?" id d3_zoya_branch_0004

    zoya "Я всегда серьёзно. Это утомительно." id d3_zoya_branch_0005

    "Я взял левую стопку." id d3_zoya_branch_0006

    "Первый лист: я у ворот, рядом фигура, закат. Подпись в углу: «день 0»." id d3_zoya_branch_0007

    "Второй: столовая, плакат падает на голову девушке в футболке «20-я смена»." id d3_zoya_branch_0008

    "Третий: площадь, я стою один, и от меня уходит тень в другую сторону." id d3_zoya_branch_0009

    mc "Это было вчера." id d3_zoya_branch_0010

    zoya "Да." id d3_zoya_branch_0011

    mc "Зоя. Я приехал три дня назад. Откуда у тебя рисунки трёхдневной давности, которые я вижу впервые?" id d3_zoya_branch_0012

    show zoya focused
    with dissolve

    zoya "Они не трёхдневной давности." id d3_zoya_branch_0013

    mc "А какой?" id d3_zoya_branch_0014

    zoya "Не знаю. Я их рисую, а они уже случились." id d3_zoya_branch_0015

    "Я взял среднюю стопку. На верхнем листе был радиоузел: пульт, микрофон, две фигуры, и одна из них держала лист бумаги." id d3_zoya_branch_0016

    "В углу — сегодняшняя дата." id d3_zoya_branch_0017

    mc "Это сейчас?" id d3_zoya_branch_0018

    zoya "Это сегодня." id d3_zoya_branch_0019

    "Правая стопка была самая тонкая. Два листа и один пустой." id d3_zoya_branch_0020

    "Первый: причал. Вода. Фигура с фонарём в поднятой руке. И ещё одна фигура — маленькая, внизу, почти неразличимая." id d3_zoya_branch_0021

    mc "Это дети?" id d3_zoya_branch_0022

    zoya "Это те, кого надо было увести." id d3_zoya_branch_0023

    "Второй: площадь на рассвете, сцена, четыре фигуры рядом. Лица не прорисованы." id d3_zoya_branch_0024

    mc "А четвёртый кто?" id d3_zoya_branch_0025

    show zoya sad
    with dissolve

    zoya "Ты." id d3_zoya_branch_0026

    mc "А ты где?" id d3_zoya_branch_0027

    zoya "Я рисую." id d3_zoya_branch_0028

    "Пустой лист лежал между ними. Она положила на него ладонь." id d3_zoya_branch_0029

    mc "Это тот, который ты боишься?" id d3_zoya_branch_0030

    zoya "Да." id d3_zoya_branch_0031

    mc "Почему?" id d3_zoya_branch_0032

    zoya "Потому что на нём то, чем всё кончится. И если я его начну — оно кончится." id d3_zoya_branch_0033

    mc "А если не начнёшь?" id d3_zoya_branch_0034

    show zoya sleepy
    with dissolve

    zoya "Тогда мы будем рисовать его вечно." id d3_zoya_branch_0035

    "Я смотрел на её руку и понимал, что она не шутит. Совсем." id d3_zoya_branch_0036

    mc "Зоя. Дорисуй." id d3_zoya_branch_0037

    show zoya focused
    with dissolve

    zoya "Что?" id d3_zoya_branch_0038

    mc "Не конец. То, что после." id d3_zoya_branch_0039

    "Она молчала так долго, что я успел передумать дважды." id d3_zoya_branch_0040

    "Потом взяла карандаш." id d3_zoya_branch_0041

    "Она рисовала быстро и без исправлений: рассвет, площадь, флагшток, ступени старой сцены. И фигуру с фонарём — но фонарь она нарисовала опущенным." id d3_zoya_branch_0042

    mc "Почему фонарь погас?" id d3_zoya_branch_0043

    zoya "Потому что он больше не нужен." id d3_zoya_branch_0044

    "Последним она провела по краю листа тонкую светлую полосу — не линию, а именно свет." id d3_zoya_branch_0045

    zoya "Это утро." id d3_zoya_branch_0046

    mc "Похоже." id d3_zoya_branch_0047

    zoya "Похоже на то, что должно быть." id d3_zoya_branch_0048

    $ zoya_love += 2
    $ drawing_completed = True

    "Она впервые за весь разговор подняла на меня глаза и посмотрела дольше секунды." id d3_zoya_branch_0049

    show zoya smile
    with dissolve

    zoya "Спасибо, что попросил." id d3_zoya_branch_0050

    mc "Я ничего не сделал." id d3_zoya_branch_0051

    zoya "Ты посмотрел. Обычно все отворачиваются." id d3_zoya_branch_0052

    hide zoya
    with dissolve

    jump d3_glitch


## ------------------------------------------------------------
## D3_ALONE — Одиночество
## Локация: площадь / лес
## Время: день, переходящий в вечер
## Музыка: mystery
## Фон: bg square → bg square_night
## Эффект: route = "none", escape_flag = True (точка невозврата)
## ------------------------------------------------------------

label d3_alone:

    play music mystery fadein 1.0 if_changed
    scene bg square
    with fade

    $ route = "none"
    $ escape_flag = True

    "Я остался один." id d3_alone_0001

    "Не потому, что никого не было. А потому, что я так решил." id d3_alone_0002

    mc "Хватит. Хватит загадок, хватит «смотри сам», хватит рисунков, которые сбываются." id d3_alone_0003

    mc "Я приехал за одним ответом. Получу — и уеду." id d3_alone_0004

    "Я пошёл к воротам." id d3_alone_0005

    "Лагерь расступался передо мной, и это было хуже, чем если бы он встал на пути." id d3_alone_0006

    scene bg square_night
    with dissolve

    "Столовая была закрыта. Не заперта — закрыта, как закрывают то, чем больше не пользуются." id d3_alone_0007

    "Библиотека — пуста, и лампа на столе не горела." id d3_alone_0008

    "Из радиоузла не доносилось ни звука." id d3_alone_0009

    "И впервые за все дни не скрипнули качели." id d3_alone_0010

    "Я сел на ступени сцены." id d3_alone_0011

    "Где-то далеко щёлкнул динамик. Но никто не заговорил." id d3_alone_0012

    "Я подождал. Ещё. И ещё." id d3_alone_0013

    mc "Ну?" id d3_alone_0014

    "Тишина." id d3_alone_0015

    "Я попытался вспомнить, как меня зовут." id d3_alone_0016

