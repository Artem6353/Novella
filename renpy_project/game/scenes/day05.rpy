## ============================================================
## scenes/day05.rpy — ДЕНЬ 5, «ПОСЛЕДНИЙ РАССВЕТ»
## D5_PREPARE      — «Подготовка»   (варианты по маршруту, флагов не меняет)
## D5_FINALE       — «Финал»        (встреча и внутреннее решение)
## D5_FINAL_CHOICE — «Выбор»        (условия — раздел 16 ГДД)
## ============================================================

## ------------------------------------------------------------
## D5_PREPARE — Подготовка
## Локация: старая сцена / радиоузел / библиотека (по маршруту)
## Время: предрассветные сумерки
## Музыка: main_theme
## Фон: bg stage
## ------------------------------------------------------------

label d5_prepare:

    call day_card("День 5", "Последний рассвет")

    play music main_theme fadein 1.0 if_changed
    scene bg stage
    with fade

    "Рассвет ещё не наступил, но ночь уже перестала быть ночью." id d5_prepare_0001

    "Лагерь просыпался не по расписанию, а по решению: в корпусах зажигался свет, скрипели двери, кто-то бежал по гравию." id d5_prepare_0002

    play sound gravel
    "Все понимали, что это утро — последнее. Или единственное." id d5_prepare_0003
    if route == "lena":
        show lena normal at tr_right
        with dissolve

        "Лена стояла на старой сцене и проверяла колокол." id d5_prepare_0004

        "Тот самый, который я слышал в лесу: медный, зелёный от времени, на самодельном кронштейне." id d5_prepare_0005

        "Она трогала его край пальцем — снова и снова, будто боялась, что он не зазвучит." id d5_prepare_0006

        lena "Он должен ударить три раза." id d5_prepare_0007

        mc "Почему три?" id d5_prepare_0008

        lena "Потому что в ту ночь я ударила два." id d5_prepare_0009

        mc "И?" id d5_prepare_0010

        show lena sad
        with dissolve

        lena "И третий услышали не все." id d5_prepare_0011

        menu:
            "Постоять рядом":
                "Я встал рядом и положил руку на кронштейн." id d5_prepare_0012

                mc "Ударит. Я подстрахую." id d5_prepare_0013

                show lena smile
                with dissolve

                lena "Спасибо." id d5_prepare_0014

                lena "И ещё… побудь здесь, пока я не решила, что скажу." id d5_prepare_0015

                mc "А если не решишь?" id d5_prepare_0016

                lena "Тогда скажу как получится. Мне двадцать лет казалось, что надо правильно." id d5_prepare_0017

            "Спросить, что она скажет":
                mc "Что ты им скажешь?" id d5_prepare_0018

                show lena mystery
                with dissolve

                lena "Не знаю." id d5_prepare_0019

                lena "Я двадцать лет репетировала и так ничего не придумала." id d5_prepare_0020

                mc "Значит, скажешь не отрепетированное." id d5_prepare_0021

                lena "Звучит страшно." id d5_prepare_0022

                mc "Звучит как ты." id d5_prepare_0023

        "Она кивнула и отвернулась к площади." id d5_prepare_0024

        hide lena
        with dissolve

    elif route == "vera":

        show vera determined at tr_right
        with dissolve

        "Вера перебирала кассеты, выбирая ту, что должна прозвучать последней." id d5_prepare_0025

        "Перед ней лежал лист, исписанный целиком и зачёркнутый целиком." id d5_prepare_0026

        vera "Двенадцать минут. Я посчитала: если говорить быстро — четырнадцать человек по именам, привет трём отрядам, объявление о закрытии и одна песня." id d5_prepare_0027

        mc "Песня обязательно?" id d5_prepare_0028

        vera "Обязательно. Иначе это не эфир, а сводка." id d5_prepare_0029

        menu:
            "Предложить помочь с текстом":
                mc "Давай я буду вторым голосом. Ты ненавидишь паузы, а вдвоём их не будет." id d5_prepare_0030

                show vera excited
                with dissolve

                vera "Ты? В эфире?" id d5_prepare_0031

                mc "Я? В эфире." id d5_prepare_0032

                vera "Тогда читаешь привет четвёртому отряду. Они украли микрофон, пусть знают, что я в курсе." id d5_prepare_0033

                mc "А если собьюсь?" id d5_prepare_0034

                vera "Не собьёшься. Я тебя перекричу." id d5_prepare_0035

            "Спросить, чего она боится":
                mc "Вера. Ты чего на самом деле боишься?" id d5_prepare_0036

                show vera thoughtful
                with dissolve

                vera "Что скажу «всем пока» — и всё." id d5_prepare_0037

                mc "И всё?" id d5_prepare_0038

                vera "И тишина. Самая длинная в моей жизни." id d5_prepare_0039

                mc "Я буду слушать." id d5_prepare_0040

                show vera happy
                with dissolve

                vera "Отлично. Значит, тишины не будет." id d5_prepare_0041

        "Она нажала «запись», услышала щелчок и успокоилась." id d5_prepare_0042

        hide vera
        with dissolve

    elif route == "zoya":

        show zoya focused at tr_right
        with dissolve

        "Зоя смешивала краски, но её пальцы дрожали." id d5_prepare_0043

        "Перед ней стоял тот самый лист — с рассветом, площадью и четырьмя фигурами без лиц." id d5_prepare_0044

        zoya "Мне нужен последний мазок." id d5_prepare_0045

        mc "Какой?" id d5_prepare_0046

        zoya "Светлый." id d5_prepare_0047

        mc "А если тёмный?" id d5_prepare_0048

        show zoya sad
        with dissolve

        zoya "Тогда картина останется здесь. Вместе со мной." id d5_prepare_0049

        menu:
            "Держать лист, пока она рисует":
                "Я встал с другой стороны и придержал край." id d5_prepare_0050

                mc "Держу. Руки свободны." id d5_prepare_0051

                show zoya calm
                with dissolve

                zoya "Ты дышишь громко." id d5_prepare_0052

                mc "Прости." id d5_prepare_0053

                zoya "Не надо. Так я знаю, что ты здесь." id d5_prepare_0054

            "Спросить, что она рисует":
                mc "Что там будет в конце?" id d5_prepare_0055

                show zoya sleepy
                with dissolve

                zoya "Утро." id d5_prepare_0056

                mc "Какое?" id d5_prepare_0057

                zoya "Такое, после которого все просыпаются в своих кроватях." id d5_prepare_0058

                mc "И ты?" id d5_prepare_0059

                zoya "Я просыпаюсь в рисунке. Это не плохо." id d5_prepare_0060

        "Она взяла кисть и замерла на полсекунды — ровно столько, сколько нужно, чтобы решиться." id d5_prepare_0061

        hide zoya
        with dissolve

    else:

        "Я собирался уйти." id d5_prepare_0062

        "Рюкзак был собран ещё вчера: куртка, билет, фотография, которую я не нашёл, и листок расписания на память." id d5_prepare_0063

        "Я дошёл до ворот." id d5_prepare_0064

        "Ворота были открыты. Дорога — на месте. Автобусная остановка — в четырёх километрах." id d5_prepare_0065

        "Я стоял и не мог сделать шаг." id d5_prepare_0066

        mc "Ну. Иди." id d5_prepare_0067

        "Ноги не пошли." id d5_prepare_0068

        "Не потому, что лагерь держал. Он уже ничего не держал — я чувствовал это так же ясно, как чувствуют, что в доме выключили электричество." id d5_prepare_0069

        "Просто я не помнил, зачем пришёл." id d5_prepare_0070

        "И не помнил, куда собирался." id d5_prepare_0071

        mc "Артём. Меня зовут Артём. Я приехал за отцом." id d5_prepare_0072

        "Фраза получилась ровной и пустой, как текст на рекламном щите." id d5_prepare_0073

    jump d5_finale


## ------------------------------------------------------------
## D5_FINALE — Финал
## Локация: старая сцена / причал
## Время: предрассветные сумерки, переходящие в рассвет
## Музыка: finale
## Фон: bg stage
## ------------------------------------------------------------

label d5_finale:

    play music finale fadein 1.5 if_changed
    scene bg stage
    with fade

    "На площадь вышли все." id d5_finale_0001

    "Дети строились по отрядам — молча, без вожатских криков. Никто не бегал. Никто не кричал про линейку." id d5_finale_0002

    "Флагшток скрипнул один раз и замолчал.{w}" id d5_finale_0003

    pause 0.8

    "Воздух был холодный и неподвижный, как перед грозой, — но грозы не было.{w}" id d5_finale_0004

    "Над рекой стоял туман, и в нём угадывался причал: ровный, целый, без провисшей секции.{p}" id d5_finale_0005

    "Таким я его ещё не видел." id d5_finale_0006

    mc "Значит, это не про доски." id d5_finale_0007

    "Я понял, что всё, что я здесь видел, было не совсем лагерем." id d5_finale_0008

    "Это был лагерь таким, каким его запомнили. Со всеми трещинами, которые кто-то очень старательно не замечал двадцать лет.{w}" id d5_finale_0009

    "Я поднялся на старую сцену. Доски держали." id d5_finale_0010
    if route == "lena":
        show lena normal at tr_center
        with dissolve

        "Лена стояла у края старой сцены." id d5_finale_0011

        "В её взгляде была не мольба, а принятие." id d5_finale_0012

        lena "Все здесь." id d5_finale_0013

        mc "Все." id d5_finale_0014

        lena "Тогда можно." id d5_finale_0015

        mc "Что — можно?" id d5_finale_0016

        show lena smile
        with dissolve

        lena "Закончить." id d5_finale_0017

        "Она протянула мне верёвку колокола." id d5_finale_0018

        lena "Три удара. Ты — третий." id d5_finale_0019

        mc "Почему я?" id d5_finale_0020

        lena "Потому что ты пришёл извне. Тебе поверят." id d5_finale_0021

        hide lena
        with dissolve

    elif route == "vera":

        show vera determined at tr_center
        with dissolve

        "Вера смотрела на меня так, будто от моего ответа зависело, зазвучит ли эфир." id d5_finale_0022

        "Микрофон был включён. Красная лампочка на пульте горела ровно." id d5_finale_0023

        vera "Двенадцать минут. Начали." id d5_finale_0024

        mc "А если не получится?" id d5_finale_0025

        vera "Получится. Я двадцать лет ждала второго голоса." id d5_finale_0026

        hide vera
        with dissolve

    elif route == "zoya":

        show zoya calm at tr_center
        with dissolve

        "Зоя держала картину, и в ней отражалось всё, что мы пережили." id d5_finale_0027

        "Площадь. Костёр. Причал. Фонарь, опущенный вниз. И светлая полоса по краю — не линия, а именно свет." id d5_finale_0028

        zoya "Когда я поставлю последний мазок, всё кончится." id d5_finale_0029

        mc "Я знаю." id d5_finale_0030

        zoya "Ты уверен?" id d5_finale_0031

        mc "Нет." id d5_finale_0032

        show zoya smile
        with dissolve

        zoya "Хорошо. Уверенные обычно врут." id d5_finale_0033

        hide zoya
        with dissolve

    else:

        "Я стоял у старой сцены один." id d5_finale_0034

        "Лагерь больше не звал и не удерживал." id d5_finale_0035

        "Он просто ждал моего ответа." id d5_finale_0036

        "Дети стояли ровными рядами и не смотрели на меня. Лена стояла у причала, спиной. Веры и Зои не было вовсе." id d5_finale_0037

        "Я открыл рот, чтобы позвать хоть кого-нибудь." id d5_finale_0038

        "И не вспомнил ни одного имени." id d5_finale_0039

    "Где-то в столовой кто-то поставил кружку на стол. Звук был один — и он разнёсся по всей площади, как удар колокола." id d5_finale_0040

    "Дети замерли. Все сразу — так замирают, когда ждут, что сейчас скажет взрослый." id d5_finale_0041

    mc "Так. Хватит." id d5_finale_0042

    "Я сказал это громче, чем собирался." id d5_finale_0043

    "И площадь ответила: где-то за корпусами хлопнула дверь, скрипнули качели, и динамик над столовой щёлкнул, готовясь говорить." id d5_finale_0044

    "Лагерь проснулся. Весь сразу. Впервые за четыре дня — не по кругу, а по-настоящему." id d5_finale_0045

    "Над деревьями посветлело." id d5_finale_0046

    "Где-то за рекой ударили в колокол — один раз. Пробуя." id d5_finale_0047

    play sound bell
    "Теперь нужно было решить, чем закончится это лето." id d5_finale_0048

    jump d5_final_choice


## ------------------------------------------------------------
## D5_FINAL_CHOICE — Финальный выбор
## Условия строго по разделу 16 дизайн-документа.
## При escape_flag выбора нет: мир больше не спорит.
## ------------------------------------------------------------

label d5_final_choice:

    play music finale fadein 1.0 if_changed
    ## При escape_flag игрок не видит меню финального выбора.
    ## Это осознанное решение: он уже выбрал уйти.
    if escape_flag:

        ## Точка невозврата: блокируем откат, чтобы игрок не «перевыбрал» финал.
        $ renpy.block_rollback()

        scene bg gate_night
        with fade

        "Поздно что-то менять." id d5_final_choice_0001

        mc "Я сам выбрал уйти." id d5_final_choice_0002

        "Лагерь больше не спорил." id d5_final_choice_0003

        "Я чувствовал, как память уходит — не рывком, а тихо, как уходит вода из ладоней." id d5_final_choice_0004

        "Сначала исчезли имена. Потом лица. Потом причина, по которой я вообще здесь стоял." id d5_final_choice_0005

        "Осталось только забыть." id d5_final_choice_0006

        $ final_choice = "forget"

        jump determine_ending

    scene bg stage
    with fade

    "Передо мной лежало всё, что я нашёл за эти дни: билет, журнал, кассета, фотография, записка и рисунок." id d5_final_choice_0007

    "Шесть кусков чужой памяти — и одна моя." id d5_final_choice_0008

    "Я перебирал их в голове по одному, как перебирают вещи в коробке, которую больше не откроют." id d5_final_choice_0009

    "Билет, который отец носил двадцать лет и не выбросил." id d5_final_choice_0010

    "Журнал, где моя фамилия стояла рядом с фамилией Лены." id d5_final_choice_0011

    "Кассета, на которой молодой мужской голос просит ответа." id d5_final_choice_0012

    "Фотография, на которой они оба счастливы и оба не знают, что будет через три дня." id d5_final_choice_0013

    "Записка под половицей: «Лена, прости. Я не успел сказать»." id d5_final_choice_0014

    "И рисунок девочки, которая боялась нарисовать конец." id d5_final_choice_0015

    mc "Вот и всё. Больше ничего нет." id d5_final_choice_0016

    "Лагерь ждал." id d5_final_choice_0017

    "Дети ждали." id d5_final_choice_0018

    "Лена, Вера, Зоя — каждая на своём месте — ждали." id d5_final_choice_0019

    "И самое страшное было не в том, что мне нужно выбрать." id d5_final_choice_0020

    "А в том, что выбрать можно только один раз и только за себя." id d5_final_choice_0021

    menu:
        "Отпустить прошлое" if truth_points >= 5:
            $ final_choice = "let_go"

            mc "Хватит держать." id d5_final_choice_0022

            mc "Ни мне, ни вам." id d5_final_choice_0023

        "Остаться с Леной" if route == "lena" and lena_love >= 6:
            $ final_choice = "stay"

            show lena surprised at tr_center
            with dissolve

            mc "Я не пойду." id d5_final_choice_0024

            lena "Артём…" id d5_final_choice_0025

            mc "Я знаю, что это значит. Я всё равно не пойду." id d5_final_choice_0026

            hide lena
            with dissolve

        "Унести память с собой" if (route == "zoya" and zoya_love >= 8 and drawing_found and drawing_completed and truth_points >= 8 and memory_fragments >= 5) or (route == "lena" and persistent.true_seen and lena_love >= 8 and trusted_lena and truth_points >= 10 and memory_fragments == 6 and father_clue):
            $ final_choice = "carry_memory"

            mc "Я не буду ни забывать, ни оставаться." id d5_final_choice_0027

            mc "Я заберу это с собой. И сделаю так, чтобы вас помнили." id d5_final_choice_0028

        "Забыть и уйти":
            $ final_choice = "forget"

            mc "Мне это не нужно. Ни правда, ни вы, ни это лето." id d5_final_choice_0029

    jump determine_ending
