## ============================================================
## scenes/day04.rpy — ДЕНЬ 4, «ПРАВДА»
## D4_TRUTH   — «Правда» (техническая: без выбора, раскрывает тайну)
## D4_CONFLICT— «Конфликт» (общая по структуре, уникальная по тексту)
## ============================================================

## ------------------------------------------------------------
## D4_TRUTH — Правда
## Локация: заброшенный корпус → причал
## Время: ночь
## Музыка: mystery → finale (на причале)
## Фон: bg abandoned → bg pier → cg_d4_truth_pier (CG подключён)
## Персонажи: Артём, Лена (силуэт)
## Эффект: truth_points += 2, frag_final_note
## ------------------------------------------------------------

label d4_truth:

    call day_card("День 4", "Правда")

    play music mystery fadein 1.0 if_changed
    scene bg abandoned
    with fade

    play sound door
    "Я не помнил, как дошёл до четвёртого корпуса." id d4_truth_0001

    "Помнил только рисунок в руке и то, что бумага всё ещё была тёплая." id d4_truth_0002

    "Вожатская встретила меня тем же запахом: пыль, старая краска, смола." id d4_truth_0003

    "У стены стоял стол, на котором вчера лежали списки отрядов. Списков не было." id d4_truth_0004

    "Зато одна половица у печки сидела выше остальных." id d4_truth_0005

    mc "Конечно. Конечно, она выше." id d4_truth_0006

    play sound glass
    "Я поддел её отвёрткой, которую вчера стащил у Веры, и она пошла легко — так легко, будто её уже снимали." id d4_truth_0007

    "Под половицей лежала папка. Картонная, с завязками, мокрая по углам и высохшая намертво." id d4_truth_0008

    "Внутри — два листа." id d4_truth_0009

    "Первый: последняя страница журнала смен. Та самая, надорванная и склеенная скотчем. Только здесь строка была целой." id d4_truth_0010

    "«Лена не вышла к лодкам. Детей пересчитали — все. Её нет. Искать до утра»." id d4_truth_0011

    "Второй лист был служебной запиской.{p}" id d4_truth_0012

    "Я узнал почерк. Я узнал его раньше, чем понял, что узнал.{p}" id d4_truth_0013

    mc "«Начальнику лагеря. От радиотехника Воронова И.».{p}" id d4_truth_0014

    "Руки стали тяжёлыми. Я сел прямо на пол." id d4_truth_0015

    "«Докладываю, что в 23:40 восемнадцатого августа мною не был передан сигнал тревоги»." id d4_truth_0016

    "«Станция не отвечала. Я проверял три раза. Я должен был пойти пешком к сторожке или отправить кого-то из старших»." id d4_truth_0017

    "«Я не пошёл»." id d4_truth_0018

    "«Я слышал колокол. Я решил, что помощь уже вызвана»." id d4_truth_0019

    "«Когда нас посадили в автобус, мне сказали, что старшая вожатая ушла с младшими к лодкам. Я поверил, потому что хотел поверить»." id d4_truth_0020

    "«Я узнал на следующий день. Я молчал двадцать лет»." id d4_truth_0021

    "«Прошу прощения. Не у лагеря»." id d4_truth_0022

    "Дальше стояла одна строка, наискось, другим нажимом:" id d4_truth_0023

    "«Лена, прости. Я не успел сказать»." id d4_truth_0024

    $ truth_points += 2

    if not frag_final_note:
        $ frag_final_note = True
        $ memory_fragments += 1

    if has_ticket:
        "Старый билет в кармане словно потяжелел." id d4_truth_0025

    mc "Пап. Ты серьёзно." id d4_truth_0026

    mc "Ты двадцать лет носил это в кармане — и ни разу не сказал вслух." id d4_truth_0027

    "Я сложил оба листа и положил их на стол. Ровно. Как будто от этого зависело, услышит меня кто-нибудь или нет." id d4_truth_0028

    "И тогда я понял всё сразу — потому что понять по частям было уже нельзя." id d4_truth_0029

    "Гроза. Поднявшаяся река. Старый причал, который «осенью починим»." id d4_truth_0030

    "Младшие, отрезанные у воды. Старшая вожатая, которая увела их к лодочному спуску." id d4_truth_0031

    "Фонарь в поднятой руке. Колокол — три удара влево, вправо, вниз. Сигнал, который кто-то должен был услышать." id d4_truth_0032

    "Радиоузел, который должен был передать тревогу. Молодой парень у мёртвой станции. Три проверки. И решение не идти пешком." id d4_truth_0033

    "Детей пересчитали. Все." id d4_truth_0034

    "Её — нет." id d4_truth_0035

    mc "Злодея нет. Есть старый причал, сломанная рация и человек, который испугался." id d4_truth_0036

    mc "И двадцать лет, которые этот лагерь держит в одном дне — потому что никто не закончил прощание." id d4_truth_0037

    play music finale fadein 2.0 if_changed
    scene bg pier
    with fade

    ## CG (P2) «Сцена правды». Иллюстрация готова (images/cg_d4_truth_pier.jpg),
    ## поэтому фон заменён на CG — последовательность взята из
    ## docs/02_сценарий.md (сцена D4_TRUTH):
    ##     [ФОН: bg pier] → [FADE] → scene cg_d4_truth_pier / with fade
    ## После неё по сценарию же появляется спрайт `lena sad at tr_right`.
    scene cg_d4_truth_pier at cg_kens
    with fade

    play sound river loop
    "Я вышел к причалу." id d4_truth_0038

    "Лента на тропинке обвисла и почти истлела." id d4_truth_0039

    "Доски под ногами были мокрые, хотя дождя не было уже четыре дня." id d4_truth_0040

    "На самом краю стояла Лена. Спиной. Она не обернулась на шаги." id d4_truth_0041

    show lena sad at tr_right
    with dissolve

    lena "Ты нашёл." id d4_truth_0042

    mc "Нашёл." id d4_truth_0043

    lena "Я знала, что найдёшь. Ты слишком похож на него." id d4_truth_0044

    mc "На отца?" id d4_truth_0045

    lena "На того, кто ищет." id d4_truth_0046

    "Она обернулась. В её лице не было ни упрёка, ни мольбы." id d4_truth_0047

    "Только усталость — такая, какую не носят двадцать лет." id d4_truth_0048

    show lena anxious
    with dissolve

    lena "Артём. Я не держу тебя здесь." id d4_truth_0049

    lena "И лагерь не держит." id d4_truth_0050

    lena "Нас держит то, чего никто не закончил." id d4_truth_0051

    "И тогда лагерь показал мне. Без спроса — как показывают то, что прятали двадцать лет." id d4_truth_0100

    "Гроза пришла со стороны реки. Небо треснуло — и причал ожил в свете молний." id d4_truth_0101

    "Двадцать детей стояли на досках в пижамах и куртках на голое плечо. Трое ближе всех к воде: Миша, девять лет, держал за руку Костю, восемь. Аня, семь, прижимала к груди банку с красками." id d4_truth_0102

    child "Лена, а лодка выдержит всех?" id d4_truth_0103

    lena "Лодка выдержит. Я посчитала." id d4_truth_0104

    "Радиоузел на берегу мигал красной лампочкой. Молодой парень — Игорь, девятнадцать лет, часы без ремешка — кричал в микрофон позывные, которых никто не принял." id d4_truth_0105

    young_voice "Сосновый берег вызывает Заречье. Приём. Сосновый берег вызывает Заречье…" id d4_truth_0106

    "Сигнал не приняли. Диспетчер спал. Молния ударила в трансформатор — и свет на причале погас целиком, как выдох." id d4_truth_0107

    "Лена не кричала. Она считала. Она оттолкнула лодку от причала — руками, по пояс в ледяной воде — и крикнула детям грести к тому берегу." id d4_truth_0108

    "Доски причала пошли вниз. Тихо. Страшно тихо: ни крика, ни всплеска — только дождь, который вдруг стал единственным звуком на свете." id d4_truth_0109

    "Лодка дошла до берега. Утром детей пересчитали. Всех. Кроме неё." id d4_truth_0110

    "Видение отпустило меня так же внезапно, как взяло. Причал снова был пуст. Только доски под ногами были мокрые — хотя дождя не было четыре дня." id d4_truth_0111

    mc "Ты их вывела. Всех, до кого смогла дотянуться." id d4_truth_0112

    lena "Всех, до кого смогла дотянуться." id d4_truth_0113

    mc "Эфир. Линейка. Колокол." id d4_truth_0052

    show lena surprised
    with dissolve

    lena "Ты быстро понимаешь." id d4_truth_0053

    mc "Мне помог один человек. Он всю жизнь понимал очень медленно и очень дорого за это заплатил." id d4_truth_0054

    "Лена посмотрела на воду." id d4_truth_0055

    lena "Он не виноват в том, что испугался." id d4_truth_0056

    lena "Он виноват в том, что молчал." id d4_truth_0057

    mc "Я знаю." id d4_truth_0058

    lena "Знаешь?" id d4_truth_0059

    mc "Я только что прочитал это его почерком." id d4_truth_0060

    "Она кивнула. И впервые за четыре дня улыбнулась так, что у меня сжалось горло." id d4_truth_0061

    show lena smile
    with dissolve

    lena "Тогда завтра всё получится." id d4_truth_0062

    mc "Что именно?" id d4_truth_0063

    lena "Прощание." id d4_truth_0064

    hide lena
    with dissolve

    jump d4_conflict


## ------------------------------------------------------------
## D4_CONFLICT — Конфликт
## Локация: костровая поляна
## Время: ночь
## Музыка: main_theme
## Фон: bg campfire
## Персонажи: Артём + героиня активного маршрута (или никто)
## Эффект: +3 к очкам героини маршрута при поддержке
## ------------------------------------------------------------

label d4_conflict:

    play music main_theme fadein 1.0 if_changed
    scene bg campfire
    with fade

    play sound crickets loop
    "На поляне горел костёр. Настоящий — я видел, как он дымит." id d4_conflict_0001

    "Вокруг сидели все, кого я знал в этом лагере: Вера, Зоя, Лена и человек двадцать детей, которые не смотрели на меня." id d4_conflict_0002

    "Они ждали, что я скажу." id d4_conflict_0003
    if route == "lena":
        show lena anxious at tr_center
        with dissolve

        "Лена стояла, а не сидела. Так и не села." id d4_conflict_0004

        lena "Я не хочу, чтобы меня жалели." id d4_conflict_0005

        lena "И не хочу, чтобы его судили. Он был мальчишкой с мёртвой рацией и приказом «не поднимать панику»." id d4_conflict_0006

        show lena sad
        with dissolve

        lena "Я хочу одного: чтобы кто-нибудь сказал это вслух. При всех. Чтобы лагерь услышал." id d4_conflict_0007

        lena "Двадцать лет. Из-за того, что кто-то побоялся произнести одну фразу." id d4_conflict_0008

        "Вера опустила голову. Зоя перестала рисовать." id d4_conflict_0009

        "Все смотрели на меня." id d4_conflict_0010

        menu:
            "Сказать правду вслух":
                $ lena_love += 3

                mc "Восемнадцатого августа, в двадцать три сорок, радиотехник Игорь Воронов не передал сигнал тревоги." id d4_conflict_0011

                mc "Он испугался. Он уехал с последней группой. Он думал, что ты уже спаслась." id d4_conflict_0012

                mc "Он узнал на следующий день и молчал двадцать лет. И это его сын — я — говорит это сейчас вслух, при всех." id d4_conflict_0013

                mc "Лена Гарина, старшая вожатая двадцатой смены, увела младших к лодкам. Все дети вышли. Она — нет." id d4_conflict_0014

                mc "Она не виновата ни в чём." id d4_conflict_0015

                "Костёр стрельнул щепкой. Дети подняли головы — все сразу, как по команде." id d4_conflict_0016

                show lena sad
                with dissolve

                lena "Спасибо." id d4_conflict_0017

                lena "Мне нужно было это услышать." id d4_conflict_0018

                mc "Тебе?" id d4_conflict_0019

                lena "Нам." id d4_conflict_0020

            "Отвести взгляд":
                mc "Я… не могу. Не здесь. Не при детях." id d4_conflict_0021

                show lena sad
                with dissolve

                lena "Хорошо." id d4_conflict_0022

                "Она сказала это ровно. Слишком ровно — так говорят дату, которую повторяли много раз." id d4_conflict_0023

                lena "Значит, не сегодня." id d4_conflict_0024

                "Костёр горел. Никто не поднял головы." id d4_conflict_0025

                "Я понял, что только что сделал то же, что мой отец." id d4_conflict_0026

        hide lena
        with dissolve

    elif route == "vera":

        show vera offended at tr_center
        with dissolve

        "Вера вскочила первой. Она вообще не умела сидеть, когда слышала помехи." id d4_conflict_0027

        vera "Значит, так. Значит, вот почему у меня эфир оборвался на полуслове." id d4_conflict_0028

        vera "Я двадцать лет висю в этой паузе, Артём. В паузе! Знаешь, что это такое для человека, который боится тишины?" id d4_conflict_0029

        mc "Вера…" id d4_conflict_0030

        vera "Нет, ты послушай! Я же записывала объявление: «Закрытие смены завтра в девятнадцать». Я его даже не сказала до конца!" id d4_conflict_0031

        show vera determined
        with dissolve

        vera "Значит, завтра я его скажу. По-настоящему. В эфир. Чтобы весь лагерь слышал, чтобы все отряды, чтобы по именам!" id d4_conflict_0032

        vera "Иначе всё это было зря — и гроза, и причал, и то, что Лена…" id d4_conflict_0033

        "Она оборвала себя. Впервые в жизни." id d4_conflict_0034

        show vera thoughtful
        with dissolve

        vera "Прости. Я не хотела это произносить первой." id d4_conflict_0035

        menu:
            "Поддержать Веру":
                $ vera_love += 3

                mc "Не извиняйся. Ты права: если правду не сказать в эфир — её вообще никто не услышит." id d4_conflict_0036

                mc "Завтра я буду у тебя вторым голосом. Хронометражистом. Кем угодно." id d4_conflict_0037

                mc "И мы назовём всех по именам. Каждого." id d4_conflict_0038

                show vera excited
                with dissolve

                vera "Двенадцать минут. Мне нужно двенадцать минут и чтобы никто не выключил." id d4_conflict_0039

                mc "Никто не выключит." id d4_conflict_0040

                vera "Тогда пошли монтировать. Сейчас. Ночь же длинная." id d4_conflict_0041

                "Она схватила меня за рукав и потащила к радиоузлу — и я заметил, что рука у неё холодная, как у всех здесь." id d4_conflict_0042

            "Промолчать":
                mc "Я не знаю, Вера. Может, не надо в эфир. Может, пусть всё останется как есть." id d4_conflict_0043

                show vera offended
                with dissolve

                vera "«Как есть» — это я двадцать лет на полуслове." id d4_conflict_0044

                vera "Ладно. Ладно. Ты гость. Гостям можно не понимать." id d4_conflict_0045

                "Она села обратно к костру и больше не шутила до самого утра." id d4_conflict_0046

        hide vera
        with dissolve

    elif route == "zoya":

        show zoya sad at tr_center
        with dissolve

        "Зоя сидела ближе всех к огню и держала на коленях тот самый лист — с рассветом, площадью и четырьмя фигурами." id d4_conflict_0047

        zoya "Я же рисовала." id d4_conflict_0048

        mc "Рисовала." id d4_conflict_0049

        zoya "Все смотрели и говорили: «какая ты странная». Никто не сказал: «это было»." id d4_conflict_0050

        "Она подняла на меня глаза." id d4_conflict_0051

        show zoya focused
        with dissolve

        zoya "Знаешь, что самое плохое? Я нарисовала причал и фонарь за три дня до того, как это случилось." id d4_conflict_0052

        zoya "Я показала его Лене. Она сказала: «красиво»." id d4_conflict_0053

        mc "Ты не могла знать." id d4_conflict_0054

        zoya "Могла. Я знала. Я просто тоже промолчала." id d4_conflict_0055

        "Костёр стрельнул. Вера перестала перебирать кассеты." id d4_conflict_0056

        menu:
            "Назвать вещи своими именами":
                $ zoya_love += 3

                mc "Зоя. Посмотри на меня." id d4_conflict_0057

                mc "Это был рисунок. Не приказ, не донос, не вина. Рисунок девочки, которая видела слишком много." id d4_conflict_0058

                mc "Виноват старый причал. Виноваты взрослые, которые сказали «осенью починим». Виноват человек, который не передал сигнал." id d4_conflict_0059

                mc "Ты — единственная, кто пытался сказать правду, когда её ещё можно было услышать." id d4_conflict_0060

                show zoya sad
                with dissolve

                zoya "Никто так не говорил." id d4_conflict_0061

                mc "Я говорю." id d4_conflict_0062

                show zoya calm
                with dissolve

                zoya "Тогда я дорисую." id d4_conflict_0063

                mc "Что?" id d4_conflict_0064

                zoya "Утро. Настоящее. Чтобы было куда уйти." id d4_conflict_0065

            "Промолчать":
                mc "Зоя, я… не знаю, что сказать." id d4_conflict_0066

                show zoya sad
                with dissolve

                zoya "Все не знают." id d4_conflict_0067

                zoya "Поэтому я и рисую." id d4_conflict_0068

                "Она перевернула лист лицом вниз. Аккуратно. Как будто боялась разбудить." id d4_conflict_0069

        hide zoya
        with dissolve

    else:

        "Костёр горел." id d4_conflict_0070

        "Лена смотрела на меня с той стороны огня. Вера открыла рот, чтобы что-то сказать. Зоя подняла лист." id d4_conflict_0071

        "И я встал." id d4_conflict_0072

        mc "Извините." id d4_conflict_0073

        "Я ушёл с поляны первым. Даже не обернулся." id d4_conflict_0074

        "Сзади кто-то тихо сказал: «Он тоже»." id d4_conflict_0075

        "Я не понял, кто и про кого." id d4_conflict_0076

        "И не захотел понимать." id d4_conflict_0077

    "Ночь над лагерем стояла неподвижная, без ветра." id d4_conflict_0078

    "Где-то далеко щёлкнул динамик и ничего не сказал." id d4_conflict_0079

    jump d5_prepare
