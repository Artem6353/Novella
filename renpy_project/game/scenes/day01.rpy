## ============================================================
## scenes/day01.rpy
## D1_MORNING        — «Пробуждение» (атмосферная, без выбора)
## D1_CANTEEN        — «Столовая» (знакомство с Верой)
## D1_LIBRARY        — «Библиотека» (знакомство с Зоей)
## D1_EVENING_CHOICE — «Выбор вечера» (обязательный, 1 из 3)
## D1_VERA_RADIO     — «Радиоузел»
## D1_ZOYA_DRAWING   — «Рисунок»
## D1_LENA_RIVER     — «Река»
## ============================================================

## ------------------------------------------------------------
## D1_MORNING — Пробуждение
## Локация: жилой корпус, комната 12
## Время: утро
## Музыка: camp_day
## Фон: bg dorm_day
## ------------------------------------------------------------

label d1_morning:

    call day_card("День 1", "Смена продолжается")

    play music camp_day fadein 1.0 if_changed
    scene bg dorm_day
    with fade

    "Утро в корпусе пахло старой пылью и сосновой смолой." id d1_morning_0001

    "Я не сразу понял, что окно выходит не туда, куда я смотрел вчера." id d1_morning_0002

    "Вчера из него была видна река. Сегодня — волейбольная сетка." id d1_morning_0003

    mc "Отлично. Перестановка без моего участия." id d1_morning_0004

    "Стакан на тумбочке стоял ровно там, где я его оставил. Вода в нём была свежая." id d1_morning_0005

    "На расписании кто-то аккуратно обвёл сегодняшнюю дату. Ту же, что была обведена вчера." id d1_morning_0006

    "Я сказал себе, что просто устал с дороги." id d1_morning_0007

    "Я повторял это себе ещё четыре дня." id d1_morning_0008

    "Я умылся из кувшина — вода в кране шла ровно три секунды и пахла железом." id d1_morning_0009

    "За дверью корпуса кто-то пробежал по гравию. Потом ещё кто-то. Потом кто-то очень медленно прошёл мимо и остановился у моей двери." id d1_morning_0010

    "Я замер с полотенцем в руках." id d1_morning_0011

    play sound gravel
    "За дверью сказали: «Завтрак через пять минут». И ушли." id d1_morning_0012

    "Голос был взрослый. Мужской. Спокойный." id d1_morning_0013

    mc "Ну наконец-то. Хоть один живой взрослый." id d1_morning_0014

    "Я выскочил в коридор через четыре секунды." id d1_morning_0015

    "Коридор был пуст. Обе двери — открыты настежь. В конце, у выхода, качалась сетка от комаров." id d1_morning_0016

    "На стене висело расписание, и кто-то аккуратно обвёл в нём сегодняшнюю дату." id d1_morning_0017

    "Ту же самую, что была обведена вчера." id d1_morning_0018

    "На площади уже собирался народ: дети с кружками, двое мальчишек с мячом, девочка с гитарой без одной струны." id d1_morning_0019

    "Из динамика над столовой щёлкнуло, и бодрый женский голос объявил:" id d1_morning_0020

    radio "Доброе утро, «Сосновый берег»! До линейки осталось одиннадцать часов." id d1_morning_0021

    mc "Одиннадцать часов. Понял. Значит, линейка в семь." id d1_morning_0022

    "Я сказал это вслух и только потом понял, что знаю это со вчерашнего вечера." id d1_morning_0023

    "Знал — но не слышал." id d1_morning_0024

    jump d1_canteen


## ------------------------------------------------------------
## D1_CANTEEN — Столовая
## Локация: столовая
## Время: утро, после завтрака
## Музыка: camp_day
## Фон: bg canteen
## Персонажи: Артём, Вера
## ------------------------------------------------------------

label d1_canteen:

    play music camp_day fadein 1.0 if_changed
    scene bg canteen
    with fade

    ## CG (P1): знакомство с Верой
    scene cg_vera_meet
    with fade

    "В столовой пахло старой посудой и чем-то сладким." id d1_canteen_0001

    "Девушка в футболке с надписью «20-я смена» стояла на столе и пыталась снять со стены плакат." id d1_canteen_0002

    show vera happy at tr_right
    with dissolve

    vera "Ой! Не входи, не входи, тут ступенька скрипит! Я серьёзно, третья слева, она предатель." id d1_canteen_0003

    mc "Я уже на ней стою." id d1_canteen_0004

    vera "Значит, ты либо очень смелый, либо очень невнимательный. Меня зовут Вера. Ты Артём, я знаю, Лена уже сообщила по своим каналам." id d1_canteen_0005

    "Она спрыгнула, и плакат упал ей на голову." id d1_canteen_0006

    vera "Это не провал. Это перформанс." id d1_canteen_0007

    "На полу валялись листы: «План закрытия смены», «Сценарий линейки», «Эфир: хронометраж 12 минут»." id d1_canteen_0008

    show vera excited
    with dissolve

    vera "Слушай, а руки у тебя есть? Вижу, что есть. Подержи вот это, а я прибью. Только не криво, у меня криво уже было три раза." id d1_canteen_0009

    menu:
        "Помочь Вере":
            $ vera_love += 2

            "Я держал плакат, она стучала молотком, и за двадцать минут я узнал о лагере больше, чем за весь вчерашний вечер." id d1_canteen_0010

            vera "Нас тут сто сорок, если считать с малышами. Малышей считать обязательно, иначе обидятся. Я веду радиоузел, потому что никто больше не согласился." id d1_canteen_0011

            mc "А почему никто не согласился?" id d1_canteen_0012

            show vera thoughtful
            with dissolve

            vera "Потому что там тишина." id d1_canteen_0013

            "Она сказала это буднично, как говорят «потому что там холодно»." id d1_canteen_0014

            show vera happy
            with dissolve

            vera "У нас радио живёт своей жизнью. Иногда само включается. Я не боюсь, я просто разговариваю громче, чтобы оно не наглело." id d1_canteen_0015

            mc "Работает?" id d1_canteen_0016

            vera "Пока да." id d1_canteen_0017

        "Отказаться":
            $ vera_love -= 1

            mc "Я вообще-то ищу, где тут взрослые. Мне нужно позвонить." id d1_canteen_0018

            show vera stubborn
            with dissolve

            vera "А, ну да. Взрослые. Отличный вопрос. Задай его в семь вечера на площади, там все соберутся." id d1_canteen_0019

            "Она собрала листы сама. И не шутила целых десять секунд — я считал." id d1_canteen_0020

            show vera happy
            with dissolve

            vera "Ладно, не дуйся. Меня зовут Вера. Запомни, пригодится." id d1_canteen_0021

    "На секунду мне показалось, что за окном мелькнула та же фигура, что и вчера на площади." id d1_canteen_0022

    "Мальчишка, который кричал про линейку, снова пробежал мимо. В ту же сторону. С той же скоростью." id d1_canteen_0023

    vera "Не обращай внимания. У нас тут все бегают. Лагерь же." id d1_canteen_0024

    hide vera
    with dissolve

    jump d1_library


## ------------------------------------------------------------
## D1_LIBRARY — Библиотека
## Локация: библиотека
## Время: день
## Музыка: camp_day → zoya_theme
## Фон: bg library
## Персонажи: Артём, Зоя
## ------------------------------------------------------------

label d1_library:

    play music camp_day fadein 1.0 if_changed
    scene bg library
    with fade

    ## CG (P1): знакомство с Зоей
    scene cg_zoya_meet
    with fade

    "Библиотека встретила меня тишиной." id d1_library_0001

    "Такой тишиной, какую я слышал только в музеях и в очереди к стоматологу." id d1_library_0002

    "За столом сидела девушка с блокнотом. Она не подняла голову." id d1_library_0003

    show zoya calm at tr_right
    with dissolve

    zoya "Ты громко дышишь." id d1_library_0004

    mc "Прости." id d1_library_0005

    zoya "Не надо. Иначе будет совсем тихо." id d1_library_0006

    "Зоя. Так было написано на обложке блокнота — одним словом, крупно. Как будто для тех, кто забудет." id d1_library_0007

    "На столе лежали старые журналы и чей-то незаконченный рисунок: река, причал и фигура у воды." id d1_library_0008

    menu:
        "Посмотреть рисунки":
            $ drawing_found = True
            $ zoya_love += 2

            if not frag_drawing:
                $ frag_drawing = True
                $ memory_fragments += 1

            "Я наклонился к листам." id d1_library_0009

            "Качели. Костёр. Столовая. Площадь с флагштоком — и в углу дата: «17.08»." id d1_library_0010

            "И снова тот же сюжет: причал, вода, фигура с фонарём в поднятой руке." id d1_library_0011

            mc "Это кто?" id d1_library_0012

            show zoya focused
            with dissolve

            zoya "Не знаю." id d1_library_0013

            zoya "Иногда я рисую то, что ещё не случилось." id d1_library_0014

            mc "Сегодня случилось?" id d1_library_0015

            zoya "Сегодня — нет." id d1_library_0016

            "Она перевернула лист рисунком вниз. Аккуратно, как будто боялась разбудить." id d1_library_0017

        "Пройти мимо":
            "Я решил, что разглядывать чужие рисунки невежливо." id d1_library_0018

            show zoya sad
            with dissolve

            "Зоя проводила меня взглядом. Потом перевернула лист лицом вниз." id d1_library_0019

            "Мне показалось, что она сделала это слишком быстро." id d1_library_0020

    mc "Зоя. А сколько тебе лет?" id d1_library_0021

    zoya "Восемнадцать." id d1_library_0022

    mc "Всем здесь восемнадцать?" id d1_library_0023

    show zoya sleepy
    with dissolve

    zoya "Всем, кто остался." id d1_library_0024

    mc "А кто не остался?" id d1_library_0025

    zoya "Младшие." id d1_library_0026

    mc "Они уехали?" id d1_library_0027

    "Она посмотрела на меня так, как смотрят на человека, который задаёт вопрос, уже имеющий ответ." id d1_library_0028

    zoya "Они бегают по площади. Ты их видел." id d1_library_0029

    mc "Видел." id d1_library_0030

    zoya "Значит, не уехали." id d1_library_0031

    "Я сел на край стола. Она не возражала." id d1_library_0032

    mc "Ты давно здесь?" id d1_library_0033

    zoya "С начала смены." id d1_library_0034

    mc "А когда она началась?" id d1_library_0035

    show zoya focused
    with dissolve

    zoya "Пятого августа." id d1_library_0036

    mc "Какого года?" id d1_library_0037

    "Зоя не ответила. Она взяла карандаш и начала штриховать край листа — тот самый, где была вода." id d1_library_0038

    "Я не стал переспрашивать. Почему-то было понятно, что переспрашивать нельзя." id d1_library_0039

    zoya "Ты вечером придёшь?" id d1_library_0040

    mc "Куда?" id d1_library_0041

    zoya "Куда пойдёшь." id d1_library_0042

    hide zoya
    with dissolve

    jump d1_evening_choice


## ------------------------------------------------------------
## D1_EVENING_CHOICE — Выбор вечера
## Локация: главная площадь
## Время: вечер
## Музыка: main_theme
## Фон: bg square
## Обязательный выбор одной из трёх сцен (ГДД, раздел 12)
## ------------------------------------------------------------

label d1_evening_choice:

    play music main_theme fadein 1.0 if_changed
    scene bg square
    with fade

    "Вечер опускался на площадь." id d1_evening_choice_0001

    "Лагерь затих, но в этой тишине всё ещё слышалось чьё-то дыхание." id d1_evening_choice_0002

    "Из радиоузла доносился голос Веры: она репетировала эфир и спорила сама с собой." id d1_evening_choice_0003

    "В окне библиотеки горела лампа — Зоя ещё работала." id d1_evening_choice_0004

    "А у реки, на самом краю света, стояла Лена." id d1_evening_choice_0005

    "Три стороны, три вечера — и у меня было время только на один." id d1_evening_choice_0006

    "Я поймал себя на том, что считаю." id d1_evening_choice_0007

    "Не секунды, как Зоя. Я считал дни: вчера были ворота, сегодня столовая и библиотека. Завтра, по расписанию, — закрытие смены и отъезд." id d1_evening_choice_0008

    "Девятнадцатого августа автобус уходит." id d1_evening_choice_0009

    mc "Значит, у меня есть ещё один вечер. И один день." id d1_evening_choice_0010

    "В нагрудном кармане билет снова стал тёплым." id d1_evening_choice_0011

    "Я подумал, что если уеду девятнадцатого, то никогда не узнаю, почему Лена говорит так, будто уже отвечала на все мои вопросы." id d1_evening_choice_0012

    "И почему Вера так боится тишины." id d1_evening_choice_0013

    "И почему Зоя рисует вчерашний день." id d1_evening_choice_0014

    menu:
        "Пойти в радиоузел к Вере":
            $ vera_love += 2
            jump d1_vera_radio

        "Пойти в библиотеку к Зое":
            $ zoya_love += 2
            jump d1_zoya_drawing

        "Пойти к реке с Леной":
            $ lena_love += 2
            $ truth_points += 1
            jump d1_lena_river


## ------------------------------------------------------------
## D1_VERA_RADIO — Радиоузел
## Локация: радиоузел
## Время: вечер
## Музыка: vera_theme
## Фон: bg radio
## Персонажи: Артём, Вера, радио (голос из прошлого)
## ------------------------------------------------------------

label d1_vera_radio:

    play music vera_theme fadein 1.0 if_changed
    scene bg radio
    with fade

    "Радиоузел оказался комнатой размером с нашу кухню." id d1_vera_radio_0001

    "Пульт, два микрофона на штативах, шкаф с кассетами и плакат: «Говори ясно, думай громко»." id d1_vera_radio_0002

    show vera excited at tr_right
    with dissolve

    vera "Добро пожаловать в центр мира. Двенадцать минут эфира, шесть кассет и один стул, который шатается. Садись на пол, пол честнее." id d1_vera_radio_0003

    mc "У тебя тут… уютно." id d1_vera_radio_0004

    vera "У меня тут громко. Это разные вещи, но вторая полезнее." id d1_vera_radio_0005

    "Она щёлкнула тумблером. Динамик вздохнул." id d1_vera_radio_0006

    play sound cassette
    vera "Слышишь? Иногда кажется, что лагерь сам включает радио." id d1_vera_radio_0007

    "Кассета щёлкнула, и из динамика вырвался короткий шум эфира." id d1_vera_radio_0008

    play sound radio_noise
    radio "…всем отрядам построиться у…" id d1_vera_radio_0009

    "И помехи." id d1_vera_radio_0010

    show vera thoughtful
    with dissolve

    vera "Вот. Опять. Я эту плёнку знаю наизусть, там дальше песня про костёр. А тут не песня." id d1_vera_radio_0011

    mc "Что там?" id d1_vera_radio_0012

    vera "Не знаю. Но каждый раз, когда она включается, мне хочется говорить громче." id d1_vera_radio_0013

    mc "Ты и так говоришь громче." id d1_vera_radio_0014

    show vera happy
    with dissolve

    vera "Значит, всё работает." id d1_vera_radio_0015

    "Она засмеялась. Смех получился на полсекунды короче, чем нужно." id d1_vera_radio_0016

    "Повисла пауза. Вера не выдержала её первой:" id d1_vera_radio_0017

    vera "Завтра починим антенну — и я сделаю нормальный выпуск. Про всех. Чтобы каждого назвали по имени." id d1_vera_radio_0018

    mc "Зачем?" id d1_vera_radio_0019

    show vera determined
    with dissolve

    vera "Потому что хуже всего — когда человека не назовут." id d1_vera_radio_0020

    "Я не нашёлся, что ответить. Она кивнула, будто мой ответ её устроил." id d1_vera_radio_0021

    "Пауза длилась четыре секунды. Для Веры это было почти признание." id d1_vera_radio_0022

    vera "Артём, а ты чего вообще приехал?" id d1_vera_radio_0023

    mc "По билету." id d1_vera_radio_0024

    show vera stubborn
    with dissolve

    vera "Все приезжают по билету. Я про другое." id d1_vera_radio_0025

    mc "У меня отец здесь работал." id d1_vera_radio_0026

    "Вера перестала перебирать кассеты." id d1_vera_radio_0027

    vera "Кем?" id d1_vera_radio_0028

    mc "Со связью. Радиоузел." id d1_vera_radio_0029

    "Тишина. Целых три секунды — я засёк." id d1_vera_radio_0030

    show vera thoughtful
    with dissolve

    vera "Значит, ты его сын." id d1_vera_radio_0031

    mc "Ты его знала?" id d1_vera_radio_0032

    vera "Я всех знала. У меня эфир, мне положено." id d1_vera_radio_0033

    "Она сказала это слишком быстро. Так говорят, когда не хотят договаривать." id d1_vera_radio_0034

    vera "Он хороший был?" id d1_vera_radio_0035

    mc "Не знаю. Он ушёл, когда мне было семь." id d1_vera_radio_0036

    show vera sad
    with dissolve

    vera "Значит, не знаешь." id d1_vera_radio_0037

    "Пауза." id d1_vera_radio_0038

    vera "Слушай. Если завтра узнаешь что-то такое, от чего захочется уйти, — не уходи сразу." id d1_vera_radio_0039

    mc "Почему?" id d1_vera_radio_0040

    vera "Потому что потом будешь двадцать лет включать радио и слушать помехи." id d1_vera_radio_0041

    "Она отвернулась к пульту и щёлкнула тумблером — громче, чем было нужно." id d1_vera_radio_0042

    vera "Всё. Эфир окончен. Спокойной ночи, «Сосновый берег»." id d1_vera_radio_0043

    hide vera
    with dissolve

    call d1_night_walk

    jump d2_morning


## ------------------------------------------------------------
## D1_ZOYA_DRAWING — Рисунок
## Локация: библиотека / мастерская
## Время: вечер
## Музыка: zoya_theme
## Фон: bg library
## Персонажи: Артём, Зоя
## ------------------------------------------------------------

label d1_zoya_drawing:

    play music zoya_theme fadein 1.0 if_changed
    scene bg library
    with fade

    "Зоя сидела над листом бумаги и не шевелилась минуты три." id d1_zoya_drawing_0001

    "Я понял это, потому что считал." id d1_zoya_drawing_0002

    show zoya calm at tr_right
    with dissolve

    zoya "Ты считаешь. Вслух. В голове." id d1_zoya_drawing_0003

    mc "Ты слышишь?" id d1_zoya_drawing_0004

    zoya "Я вижу, как у тебя двигается челюсть." id d1_zoya_drawing_0005

    mc "И что я считаю?" id d1_zoya_drawing_0006

    zoya "Секунды. Ты боишься тишины меньше, чем она. Это редкость." id d1_zoya_drawing_0007

    "На рисунке была река, причал и фигура, которую я уже где-то видел." id d1_zoya_drawing_0008

    zoya "Иногда я рисую то, что ещё не случилось." id d1_zoya_drawing_0009

    mc "Покажи." id d1_zoya_drawing_0010

    show zoya focused
    with dissolve

    "Она разложила листы веером." id d1_zoya_drawing_0011

    "Первый: я у ворот. Закат, облупленная краска, рядом фигура." id d1_zoya_drawing_0012

    "Второй: столовая, плакат падает кому-то на голову." id d1_zoya_drawing_0013

    "Третий: площадь, я стою один." id d1_zoya_drawing_0014

    mc "Это… сегодня?" id d1_zoya_drawing_0015

    zoya "Это вчера." id d1_zoya_drawing_0016

    mc "Вчера меня здесь не было." id d1_zoya_drawing_0017

    zoya "Ты так думаешь." id d1_zoya_drawing_0018

    "Последний лист был пустой. Она положила на него ладонь — как на чью-то спину." id d1_zoya_drawing_0019

    mc "А этот?" id d1_zoya_drawing_0020

    show zoya sleepy
    with dissolve

    zoya "Этот я ещё боюсь." id d1_zoya_drawing_0021

    mc "Почему?" id d1_zoya_drawing_0022

    zoya "Потому что его нельзя исправить." id d1_zoya_drawing_0023

    "Я хотел спросить, что именно нельзя исправить. Но лампа мигнула, и Зоя уже убирала листы в папку." id d1_zoya_drawing_0024

    zoya "Иди спать. Завтра будет длинный день." id d1_zoya_drawing_0025

    mc "Откуда ты знаешь?" id d1_zoya_drawing_0026

    show zoya calm
    with dissolve

    zoya "Я его нарисовала." id d1_zoya_drawing_0027

    mc "Зоя. А меня ты рисовала?" id d1_zoya_drawing_0028

    zoya "Да." id d1_zoya_drawing_0029

    mc "Покажешь?" id d1_zoya_drawing_0030

    show zoya calm
    with dissolve

    "Она вытащила из папки лист и положила передо мной." id d1_zoya_drawing_0031

    "На рисунке была площадь. Флагшток. Ступени старой сцены." id d1_zoya_drawing_0032

    "И я — стоящий спиной, у самого края, почти у воды." id d1_zoya_drawing_0033

    "В углу стояла дата. Восемнадцатое августа." id d1_zoya_drawing_0034

    mc "Это завтра?" id d1_zoya_drawing_0035

    zoya "Это послезавтра." id d1_zoya_drawing_0036

    mc "Откуда ты знаешь, что я там буду?" id d1_zoya_drawing_0037

    show zoya sad
    with dissolve

    zoya "Я не знаю, что ты будешь." id d1_zoya_drawing_0038

    zoya "Я знаю, что ты придёшь." id d1_zoya_drawing_0039

    "Я хотел сказать, что это звучит как угроза. Не сказал." id d1_zoya_drawing_0040

    mc "А если я не приду?" id d1_zoya_drawing_0041

    zoya "Тогда рисунок останется неправильным." id d1_zoya_drawing_0042

    mc "И что?" id d1_zoya_drawing_0043

    zoya "Ничего. Просто я перестану им верить." id d1_zoya_drawing_0044

    "Она убрала лист в папку — последним, поверх пустого." id d1_zoya_drawing_0045

    zoya "Артём." id d1_zoya_drawing_0046

    mc "Да?" id d1_zoya_drawing_0047

    zoya "Если увидишь фонарь у воды — не кричи." id d1_zoya_drawing_0048

    mc "Почему?" id d1_zoya_drawing_0049

    zoya "Они пугаются. А испуганные делают лишнее." id d1_zoya_drawing_0050

    hide zoya
    with dissolve

    call d1_night_walk

    jump d2_morning


## ------------------------------------------------------------
## D1_LENA_RIVER — Река
## Локация: река, вид на причал
## Время: закат
## Музыка: lena_theme
## Фон: bg river
## Персонажи: Артём, Лена
## ------------------------------------------------------------

label d1_lena_river:

    play music lena_theme fadein 1.0 if_changed
    scene bg river
    with fade

    ## CG (P1): Лена у реки
    scene cg_lena_river
    with fade

    play sound river loop
    "Лена стояла у реки." id d1_lena_river_0001

    "Вода отражала закат, но в её глазах было что-то старше этого вечера." id d1_lena_river_0002

    show lena normal at tr_right
    with dissolve

    lena "Ты тоже чувствуешь, что это лето не хочет заканчиваться?" id d1_lena_river_0003

    mc "Я чувствую, что у меня нет связи и я не сказал дома, куда еду." id d1_lena_river_0004

    lena "Это не ответ." id d1_lena_river_0005

    mc "Это единственный ответ, который у меня есть." id d1_lena_river_0006

    show lena smile
    with dissolve

    lena "Хорошо. Тогда я тоже отвечу не по существу." id d1_lena_river_0007

    "Дальше, за изгибом, темнел причал. К нему вела тропинка, и тропинка была обвязана старой выцветшей лентой." id d1_lena_river_0008

    mc "Туда можно?" id d1_lena_river_0009

    show lena anxious
    with dissolve

    lena "Не стоит." id d1_lena_river_0010

    mc "Опасно?" id d1_lena_river_0011

    lena "Небезопасно." id d1_lena_river_0012

    mc "Это разные слова." id d1_lena_river_0013

    lena "Да." id d1_lena_river_0014

    "Пауза." id d1_lena_river_0015

    lena "Двадцать… то есть… двадцать минут назад там ещё…" id d1_lena_river_0016

    mc "Что?" id d1_lena_river_0017

    show lena sad
    with dissolve

    lena "Ничего. Я забыла, что хотела сказать." id d1_lena_river_0018

    "Она не забыла. Люди так не забывают." id d1_lena_river_0019

    mc "Ты давно в лагере?" id d1_lena_river_0020

    lena "С начала смены." id d1_lena_river_0021

    mc "А смена когда заканчивается?" id d1_lena_river_0022

    lena "Девятнадцатого августа." id d1_lena_river_0023

    mc "Сегодня какое?" id d1_lena_river_0024

    lena "Восемнадцатое." id d1_lena_river_0025

    "Она сказала это ровно. Слишком ровно — так говорят дату, которую повторяли много раз." id d1_lena_river_0026

    mc "И что будет завтра?" id d1_lena_river_0027

    show lena mystery
    with dissolve

    lena "Отъезд." id d1_lena_river_0028

    "Пауза." id d1_lena_river_0029

    lena "Наверное." id d1_lena_river_0030

    mc "Ты похожа на одного человека." id d1_lena_river_0031

    lena "На кого?" id d1_lena_river_0032

    mc "На того, кто ждёт автобуса и не может сесть." id d1_lena_river_0033

    show lena sad
    with dissolve

    "Она посмотрела на воду так долго, что я успел решить: разговор закончен." id d1_lena_river_0034

    lena "Артём." id d1_lena_river_0035

    mc "Да?" id d1_lena_river_0036

    lena "Если завтра я скажу тебе что-то странное — поверь мне сразу." id d1_lena_river_0037

    lena "У нас с тобой не так много повторов." id d1_lena_river_0038

    "Её голос прозвучал дважды. Второй раз — дальше, со стороны причала. Будто кто-то повторил за ней." id d1_lena_river_0039

    "Мы стояли молча. Река шла медленно, почти без звука." id d1_lena_river_0040

    mc "Лена." id d1_lena_river_0041

    lena "Да?" id d1_lena_river_0042

    mc "Мой отец работал здесь. В радиоузле." id d1_lena_river_0043

    show lena surprised
    with dissolve

    "Она повернулась ко мне так резко, что коса хлестнула по плечу." id d1_lena_river_0044

    lena "Фамилия." id d1_lena_river_0045

    mc "Воронов. Игорь Воронов." id d1_lena_river_0046

    "Лена не ответила. Она смотрела на воду и, кажется, не дышала." id d1_lena_river_0047

    lena "Он был здесь." id d1_lena_river_0048

    mc "Был?" id d1_lena_river_0049

    lena "В ту ночь." id d1_lena_river_0050

    mc "В какую ночь?" id d1_lena_river_0051

    show lena sad
    with dissolve

    lena "Завтра." id d1_lena_river_0052

    mc "Лена, завтра ещё не наступило." id d1_lena_river_0053

    lena "Для меня — наступило." id d1_lena_river_0054

    "Она сказала это так тихо, что я разобрал со второго раза." id d1_lena_river_0055

    mc "Что было завтра?" id d1_lena_river_0056

    "Она открыла рот. И закрыла." id d1_lena_river_0057

    lena "Я не могу." id d1_lena_river_0058

    mc "Не можешь или не хочешь?" id d1_lena_river_0059

    lena "Не могу. Пока ты не увидишь сам." id d1_lena_river_0060

    show lena anxious
    with dissolve

    lena "Артём. Обещай мне одну вещь." id d1_lena_river_0061

    mc "Какую?" id d1_lena_river_0062

    lena "Что не уедешь девятнадцатого." id d1_lena_river_0063

    mc "Я обещать не умею." id d1_lena_river_0064

    lena "Тогда просто не уезжай." id d1_lena_river_0065

    "Я посмотрел на причал. Лента на тропинке качнулась — хотя ветра не было." id d1_lena_river_0066

    hide lena
    with dissolve

    call d1_night_walk

    jump d2_morning


## ------------------------------------------------------------
## D1_NIGHT_WALK — служебная метка
## Короткий текстовый сбой в конце Дня 1 (ГДД, раздел 9, п.8:
## «короткий визуальный или текстовый сбой в конце Дня 1»).
## ------------------------------------------------------------

label d1_night_walk:

    play music mystery fadein 1.5 if_changed
    scene bg square_night
    with fade

    "Я шёл обратно в корпус." id d1_night_walk_0001

    "Свет мигнул." id d1_night_walk_0002

    "На секунду я снова стоял у ворот, и голос совсем рядом произнёс:" id d1_night_walk_0003

    "«Смотря что ты понимаешь под словом „живой“»." id d1_night_walk_0004

    scene bg dorm_night
    with dissolve

    "Потом это была просто дорожка, фонарь и моя комната." id d1_night_walk_0005

    mc "Так. Это уже лишнее." id d1_night_walk_0006

    "Я лёг и долго слушал, как скрипят качели, на которых никто не качается." id d1_night_walk_0007

    play sound swing loop
    "Скрип шёл по кругу: раз, два, три. Пауза. Раз, два, три." id d1_night_walk_0008

    "Я считал до сорока, потом сбился, потом начал заново." id d1_night_walk_0009

    "В кармане куртки, брошенной на стул, лежал билет. Я точно помнил, что положил его в карман рубашки." id d1_night_walk_0010

    mc "Ладно. Значит, я сам переложил." id d1_night_walk_0011

    "Я не перекладывал." id d1_night_walk_0012

    "За окном кто-то прошёл по дорожке — медленно, с остановками, как ходят люди, которые ждут, пока все уснут." id d1_night_walk_0013

    "Я не стал смотреть." id d1_night_walk_0014

    "В тот вечер я впервые подумал, что лагерь не держит меня." id d1_night_walk_0015

    "Он просто не выпускает из виду." id d1_night_walk_0016

    return
