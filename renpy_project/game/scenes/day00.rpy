## ============================================================
## scenes/day00.rpy
## D00_GATE   — «Ворота»
## D00_SQUARE — «Площадь»
##
## Текст сцены у ворот и площади частично совпадает с рабочим
## примером вертикального среза (раздел 34 ГДД) — это канон проекта.
## Флаги взяты строго из раздела 12 ГДД.
## ============================================================

## ------------------------------------------------------------
## D00_GATE — Ворота
## Локация: ворота лагеря «Сосновый берег»
## Время: закат
## Музыка: main_theme → lena_theme
## Фон: bg gate → cg_lena_gate (CG подключён)
## Персонажи: Артём, Лена
## ------------------------------------------------------------

label d00_gate:

    play music main_theme fadein 1.0 if_changed
    scene bg gate
    with fade

    play sound gate_creak
    ## CG (P0) «Лена у ворот». Иллюстрация готова (images/cg_lena_gate.jpg),
    ## поэтому фон заменён на CG — ровно так, как предписано в
    ## docs/02_сценарий.md (сцена D00_GATE) и в шапке этой сцены:
    ##     [ФОН: bg gate] → [FADE] → scene cg_lena_gate / with fade
    ## `scene bg gate` выше оставлен намеренно: docs/02 задаёт обе смены фона.
    scene cg_lena_gate
    with fade

    "Остановка оказалась пустынной." id d00_gate_0001

    "Передо мной стояли старые деревянные ворота." id d00_gate_0002

    "Краска на них облупилась, но сама надпись читалась ясно:" id d00_gate_0003

    "«Лагерь „Сосновый берег“»." id d00_gate_0004

    "За воротами — площадь, флагшток, ряды корпусов. Всё как на выцветшей фотографии из коробки." id d00_gate_0005

    "Только живое." id d00_gate_0006

    "В окнах корпусов горел свет. Не аварийный, не лунный — тёплый, ламповый, как в доме, где ждут." id d00_gate_0007

    "Откуда-то тянуло дымом и жареной картошкой. Где-то скрипели качели." id d00_gate_0008

    mc "Так. Стоп." id d00_gate_0009

    "Я достал телефон. Ни сети, ни вайфая, ни даже значка «только экстренные вызовы»." id d00_gate_0010

    "Последний раз я видел такой экран в подвале бабушкиной дачи." id d00_gate_0011

    mc "Лагерь, закрытый двадцать лет назад, который кормит картошкой в десять вечера. Отлично. Я хотя бы не зря ехал." id d00_gate_0012

    mc "Ну и где тут хотя бы кто-нибудь живой?" id d00_gate_0013

    "Смотря что ты понимаешь под словом «живой»." id d00_gate_0014

    "Голос прозвучал так близко, что я вздрогнул." id d00_gate_0015

    show lena normal at tr_right
    with dissolve

    mc "Эм… Это был вопрос?" id d00_gate_0016

    lena "Скорее предупреждение." id d00_gate_0017

    "Я обернулся." id d00_gate_0018

    "Она стояла в трёх шагах — высокая, в белой лагерной рубашке с закатанными рукавами, с косой, переброшенной через плечо." id d00_gate_0019

    "За её спиной солнце садилось ровно так, как садится только в воспоминаниях: слишком красиво, чтобы быть правдой." id d00_gate_0020

    menu:
        "Спросить, кто она":
            $ lena_love += 1

            mc "А ты кто?" id d00_gate_0021

            lena "Меня зовут Лена." id d00_gate_0022

            lena "И ты опоздал на линейку." id d00_gate_0023

        "Отшутиться":
            $ lena_love += 2

            mc "Отлично. Значит, призраки тоже считаются." id d00_gate_0024

            lena "Пока не знаю." id d00_gate_0025

            lena "Но ты первый, кто меня услышал." id d00_gate_0026

    "На секунду мне показалось, что её голос прозвучал дважды." id d00_gate_0027

    "Словно кто-то повторил эти слова очень далеко." id d00_gate_0028

    lena "У тебя билет." id d00_gate_0029

    mc "Откуда ты…" id d00_gate_0030

    lena "Ты держишься за карман каждые десять шагов." id d00_gate_0031

    lena "Все так делают, когда боятся потерять." id d00_gate_0032

    play music lena_theme fadein 2.0 if_changed
    lena "Пойдём. Тебя надо устроить до заката." id d00_gate_0033

    mc "Устроить куда?" id d00_gate_0034

    lena "В смену." id d00_gate_0035

    mc "Я вообще-то не записывался." id d00_gate_0036

    lena "Ты приехал." id d00_gate_0037

    mc "Я приехал посмотреть." id d00_gate_0038

    lena "Здесь так не бывает." id d00_gate_0039

    "Она толкнула створку ворот. Та пошла легко — слишком легко для конструкции, которая выглядит на тридцать лет старше меня." id d00_gate_0040

    play sound gate_creak
    mc "А если я не останусь?" id d00_gate_0041

    lena "Тогда уедешь." id d00_gate_0042

    "Пауза." id d00_gate_0043

    lena "Девятнадцатого." id d00_gate_0044

    jump d00_square


## ------------------------------------------------------------
## D00_SQUARE — Площадь
## Локация: главная площадь лагеря
## Время: сумерки
## Музыка: lena_theme
## Фон: bg square
## Персонажи: Артём, Лена, ребёнок (голос)
## ------------------------------------------------------------

label d00_square:

    play music lena_theme fadein 1.0 if_changed
    scene bg square
    with fade

    "Мы вышли к старой площади." id d00_square_0001

    "Флагшток скрипел на ветру." id d00_square_0002

    "Где-то в глубине лагеря тихо звякнуло стекло." id d00_square_0003

    play sound glass
    child "Линейка в семь! Не опаздывай!" id d00_square_0004

    "Мальчишка лет десяти пробежал мимо и исчез между корпусами." id d00_square_0005

    "Я не успел даже повернуть голову." id d00_square_0006

    "По площади шли дети. Не толпой, а по двое-трое, как идут после ужина: кто-то нёс кружку, кто-то — гитару без струны." id d00_square_0007

    "Никто не смотрел на меня. Никто не смотрел и на Лену." id d00_square_0008

    mc "У вас тут… смена идёт?" id d00_square_0009

    lena "Идёт." id d00_square_0010

    mc "А взрослые где?" id d00_square_0011

    lena "Взрослые всегда где-то рядом." id d00_square_0012

    lena "Просто не здесь." id d00_square_0013

    show lena normal at tr_right
    with dissolve

    lena "Как тебя зовут?" id d00_square_0014

    mc "Артём." id d00_square_0015

    lena "Артём…" id d00_square_0016

    "Она произнесла моё имя так, будто уже слышала его." id d00_square_0017

    "Но не здесь." id d00_square_0018

    "И не сейчас." id d00_square_0019

    lena "Странно." id d00_square_0020

    mc "Что именно?" id d00_square_0021

    lena "Мне кажется, я уже знаю это имя." id d00_square_0022

    menu:
        "Спросить про лагерь":
            $ truth_points += 1

            mc "Расскажи про лагерь. Сколько здесь людей? Смена какая?" id d00_square_0023

            lena "Двадцатая." id d00_square_0024

            lena "И людей ровно столько, сколько нужно." id d00_square_0025

            mc "Это ответ или уклонение?" id d00_square_0026

            lena "А ты как думаешь?" id d00_square_0027

            "Я подумал, что лагерь, в котором нет ни одного взрослого, называется как-то иначе." id d00_square_0028

        "Промолчать":
            "Я решил не спрашивать. Пока." id d00_square_0029

            "Лена кивнула так, будто молчание тоже было ответом — и ответ этот ей не понравился." id d00_square_0030

            lena "Правильно. Сначала посмотри." id d00_square_0031

    play sound radio_noise
    "Где-то далеко, за деревьями, щёлкнул старый динамик." id d00_square_0032

    "Из него на мгновение вырвался обрывок пионерской песни." id d00_square_0033

    "И оборвался." id d00_square_0034

    lena "Пойдём." id d00_square_0035

    lena "Не стоит оставаться здесь после заката." id d00_square_0036

    mc "Почему?" id d00_square_0037

    lena "Потому что лагерь никогда не бывает пустым." id d00_square_0038

    hide lena
    with dissolve

    "Меня поселили в четвёртый корпус, комната двенадцать." id d00_square_0039

    "На тумбочке лежала стопка постельного белья и расписание." id d00_square_0040

    "Подъём — восемь. Завтрак — девять. Линейка — девятнадцать." id d00_square_0041

    "Внизу кто-то приписал карандашом: «не опаздывай»." id d00_square_0042

    "Я сел на кровать и вдруг понял, что не могу вспомнить ни одного лица вожатого." id d00_square_0043

    "Ни одного. За целый вечер." id d00_square_0044

    "Телефон по-прежнему не находил сеть. На экране стояло 18 августа, 23:41." id d00_square_0045

    "Я посмотрел на дату ещё раз. Потом на расписание. Потом снова на дату." id d00_square_0046

    mc "Ладно. Один день. Утром разберусь и уеду." id d00_square_0047

    "Я сказал это вслух, потому что в пустой комнате мысли звучали слишком громко." id d00_square_0048

    "За окном скрипнули качели. Раз, два, три. Пауза. Раз, два, три." id d00_square_0049

    call day_card("День 0", "Последнее лето начинается")

    jump d1_morning
